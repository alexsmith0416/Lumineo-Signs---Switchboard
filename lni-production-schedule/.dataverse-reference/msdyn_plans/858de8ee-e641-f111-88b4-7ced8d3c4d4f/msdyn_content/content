{
  "personasAndUserStories": [
    {
      "user": {
        "id": "Production scheduler",
        "name": "Production scheduler",
        "description": "Person responsible for scheduling jobs, resources, and employees.",
        "image": "https://content.powerapps.com/resource/makerx/static/media/PersonAccounts.bd1e9daf.svg"
      },
      "userStories": [
        {
          "id": "us01",
          "description": "View a dashboard of department tiles with job count, estimated hours, and capacity so that I can monitor workload and status instantly.",
          "userType": "Production scheduler"
        },
        {
          "id": "us02",
          "description": "Search for jobs by Job No. so that I can quickly find details and assign resources.",
          "userType": "Production scheduler"
        },
        {
          "id": "us03",
          "description": "Import job and estimate data from Business Central or enter it manually when data is limited so that all jobs are represented.",
          "userType": "Production scheduler"
        },
        {
          "id": "us04",
          "description": "Set up employee profiles with regular work hours and overtime options so that schedules reflect true capacity.",
          "userType": "Production scheduler"
        },
        {
          "id": "us05",
          "description": "Create, edit, or split scheduled blocks across multiple workdays so that jobs are assigned within regular working hours.",
          "userType": "Production scheduler"
        },
        {
          "id": "us06",
          "description": "Back-schedule from a required completion date based on job and employee availability so that start dates are realistic.",
          "userType": "Production scheduler"
        },
        {
          "id": "us07",
          "description": "Detect and flag scheduling conflicts and overloaded employees so that I can resolve resource clashes before finalizing.",
          "userType": "Production scheduler"
        },
        {
          "id": "us08",
          "description": "View and filter a weekly employee calendar with job cards so that I can visualize assignments across the team.",
          "userType": "Production scheduler"
        },
        {
          "id": "us09",
          "description": "Access an unscheduled work queue to assign outstanding tasks so that no work is left unplanned.",
          "userType": "Production scheduler"
        },
        {
          "id": "us10",
          "description": "Review all schedule blocks, conflicts, and unscheduled hours before committing so that schedules are complete and errors are avoided.",
          "userType": "Production scheduler"
        },
        {
          "id": "us11",
          "description": "Export or print the current schedule so that updates can be shared or entered into Business Central if needed.",
          "userType": "Production scheduler"
        }
      ]
    },
    {
      "user": {
        "id": "Production supervisor",
        "name": "Production supervisor",
        "description": "Supervisor overseeing departments, job status, and resource allocation.",
        "image": "https://content.powerapps.com/resource/makerx/static/media/PersonAvailable.807f0e9a.svg"
      },
      "userStories": [
        {
          "id": "us12",
          "description": "Monitor department workloads and capacity in real time so that I can adjust priorities and balance resources.",
          "userType": "Production supervisor"
        },
        {
          "id": "us13",
          "description": "View overloaded or at-risk employees so that I can intervene to reassign or support them.",
          "userType": "Production supervisor"
        },
        {
          "id": "us14",
          "description": "Filter the weekly calendar by department so that I can track multiple teams efficiently.",
          "userType": "Production supervisor"
        },
        {
          "id": "us15",
          "description": "Review conflict flags and department statuses so that I am aware of issues requiring action.",
          "userType": "Production supervisor"
        }
      ]
    },
    {
      "user": {
        "id": "Employee",
        "name": "Employee",
        "description": "Employee assigned to production work or scheduled tasks.",
        "image": "https://content.powerapps.com/resource/makerx/static/media/PersonStar.d9309781.svg"
      },
      "userStories": [
        {
          "id": "us16",
          "description": "View my assigned jobs and daily schedule so that I know what I am working on each day.",
          "userType": "Employee"
        },
        {
          "id": "us17",
          "description": "See updates or changes to my work assignments so that I stay informed of new tasks.",
          "userType": "Employee"
        },
        {
          "id": "us18",
          "description": "Access notes and timing details for each scheduled block so that I have all information to perform my duties.",
          "userType": "Employee"
        }
      ]
    }
