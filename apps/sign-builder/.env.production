# Production cross-link: the deployed Estimating URL.
# Used by the "Send to Estimating" button. Baked in at `vite build`
# (production mode). A `window.LUMINEO_ESTIMATING_URL` at runtime, or a
# Vercel env var of the same name, overrides this.
VITE_ESTIMATING_URL=https://lumineo-estimating.vercel.app/
