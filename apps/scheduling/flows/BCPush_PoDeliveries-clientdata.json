                    "$select": "crfdf_pono,crfdf_jobno,crfdf_receiveddate,crfdf_site,crfdf_location,crfdf_receivedby,crfdf_notes,crfdf_final",
                    "$filter": "crfdf_podeliveryid eq @{triggerOutputs()?['body/crfdf_podeliveryid']}"
