                  "Succeeded"
                ]
              },
              "expression": {
                "greater": [
                  "@length(body('Find_Removed')?['value'])",
                  0
                ]
              },
              "actions": {
                "Delete_In_BC": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "DELETE",
                    "uri": "@{parameters('Bc_ApiBase')}/lumineo/planning/v1.0/companies(@{parameters('Bc_CompanyId')})/poDeliveries(@{triggerOutputs()?['body/crfdf_podeliveryid']})",
                    "headers": {
