            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Removed_In_The_App": {
          "type": "If",
          "runAfter": {},
          "expression": {
            "equals": [
