                },
                "actions": {
                  "Body": {
                    "type": "Compose",
                    "runAfter": {},
                    "inputs": "@if(empty(take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_receiveddate'], '')), 10)), addProperty(addProperty(addProperty(addProperty(addProperty(addProperty(addProperty(json('{}'), 'poNo', toUpper(take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_pono'], '')), 20))), 'receivedAt', take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_site'], '')), 50)), 'jobNo', toUpper(take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_jobno'], '')), 20))), 'storageLocation', take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_location'], '')), 100)), 'receivedBy', take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_receivedby'], '')), 100)), 'notes', take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_notes'], '')), 250)), 'final', equals(first(body('Get_Delivery')?['value'])?['crfdf_final'], true)), addProperty(addProperty(addProperty(addProperty(addProperty(addProperty(addProperty(addProperty(json('{}'), 'poNo', toUpper(take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_pono'], '')), 20))), 'receivedAt', take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_site'], '')), 50)), 'jobNo', toUpper(take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_jobno'], '')), 20))), 'storageLocation', take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_location'], '')), 100)), 'receivedBy', take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_receivedby'], '')), 100)), 'notes', take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_notes'], '')), 250)), 'final', equals(first(body('Get_Delivery')?['value'])?['crfdf_final'], true)), 'dateReceived', take(trim(coalesce(first(body('Get_Delivery')?['value'])?['crfdf_receiveddate'], '')), 10)))"
                  },
                  "Find_In_BC": {
                    "type": "Http",
                    "runAfter": {
                      "Body": [
                        "Succeeded"
                      ]
                    },
                    "inputs": {
                      "method": "GET",
                      "uri": "@{parameters('Bc_ApiBase')}/lumineo/planning/v1.0/companies(@{parameters('Bc_CompanyId')})/poDeliveries?$filter=@{encodeUriComponent(concat('id eq ', triggerOutputs()?['body/crfdf_podeliveryid']))}",
                      "headers": {
                        "Accept": "application/json"
