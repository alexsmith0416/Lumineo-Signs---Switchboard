{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_4a52d"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "comment": "BCSync_TaskCompletions - GENERATED by _gen_taskcompletions_flow.py; edit that, not this. Every 5 min: the shop floor's Task complete ticks from BC into crfdf_taskcompletion (pending) for the app to apply. See BCSync_TaskCompletions.md.",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Bc_ApiBase": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com/v2.0/fe0182fa-d183-46ab-8493-9e8ea9c3d0b8/UAT/api"
        },
        "Bc_CompanyId": {
          "type": "String",
          "defaultValue": "4738bfb5-a06d-ec11-bf27-000d3a132a9e"
        },
        "Bc_Tenant": {
          "type": "String",
          "defaultValue": "fe0182fa-d183-46ab-8493-9e8ea9c3d0b8"
        },
        "Bc_Audience": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com"
        },
        "Bc_ClientId": {
          "type": "String",
          "defaultValue": "<< Postman app registration client id >>"
        },
        "Bc_ClientSecret": {
          "type": "String",
          "defaultValue": "<< store in Key Vault / secure env var - do NOT commit >>"
        }
      },
      "triggers": {
        "When_a_check_is_requested": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "crfdf_syncrequest",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "crfdf_kind eq 'taskcompletions'"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Mark_Running": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "parameters": {
              "entityName": "crfdf_syncrequests",
              "recordId": "@triggerOutputs()?['body/crfdf_syncrequestid']",
              "item/crfdf_status": "Running",
              "item/crfdf_result": ""
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateOnlyRecord"
            }
          }
        },
        "Check_BC": {
          "type": "Scope",
          "runAfter": {
            "Mark_Running": [
              "Succeeded"
            ]
          },
          "actions": {
            "Last_Copied": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "parameters": {
                  "entityName": "crfdf_taskcompletions",
                  "$select": "crfdf_entryno",
                  "$orderby": "crfdf_entryno desc",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords"
                }
              }
            },
            "Since_Entry": {
              "type": "Compose",
              "runAfter": {
                "Last_Copied": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(first(body('Last_Copied')?['value'])?['crfdf_entryno'], 0)"
            },
            "Get_New_Completions": {
              "type": "Http",
              "runAfter": {
                "Since_Entry": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "method": "GET",
                "uri": "@{parameters('Bc_ApiBase')}/lumineo/planning/v1.0/companies(@{parameters('Bc_CompanyId')})/taskCompletions?$filter=@{encodeUriComponent(concat('entryNo gt ', string(outputs('Since_Entry'))))}&$orderby=entryNo",
                "headers": {
                  "Accept": "application/json"
                },
                "authentication": {
                  "type": "ActiveDirectoryOAuth",
                  "authority": "https://login.microsoftonline.com",
                  "tenant": "@parameters('Bc_Tenant')",
                  "audience": "@parameters('Bc_Audience')",
                  "clientId": "@parameters('Bc_ClientId')",
                  "secret": "@parameters('Bc_ClientSecret')"
                }
              }
            },
            "For_each_completion": {
              "type": "Foreach",
              "foreach": "@body('Get_New_Completions')?['value']",
              "runAfter": {
                "Get_New_Completions": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Add_Pending": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "parameters": {
                      "entityName": "crfdf_taskcompletions",
                      "item/crfdf_name": "@concat('BC ', string(items('For_each_completion')?['entryNo']))",
                      "item/crfdf_entryno": "@items('For_each_completion')?['entryNo']",
                      "item/crfdf_jobno": "@coalesce(items('For_each_completion')?['jobNo'], '')",
                      "item/crfdf_jobtaskno": "@coalesce(items('For_each_completion')?['jobTaskNo'], '')",
                      "item/crfdf_taskdesc": "@coalesce(items('For_each_completion')?['jobTaskDescription'], '')",
                      "item/crfdf_resourceno": "@coalesce(items('For_each_completion')?['resourceNo'], '')",
                      "item/crfdf_resourcename": "@coalesce(items('For_each_completion')?['resourceName'], '')",
                      "item/crfdf_completedat": "@coalesce(items('For_each_completion')?['completedAt'], '')",
                      "item/crfdf_source": "@coalesce(items('For_each_completion')?['source'], '')",
                      "item/crfdf_state": "pending"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord"
                    }
                  }
                }
              }
            }
          }
        },
        "From_The_Scheduler": {
          "type": "If",
          "runAfter": {
            "Check_BC": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@triggerOutputs()?['body/crfdf_requestedby']",
              "Scheduler"
            ]
          },
          "actions": {
            "Remove_Scheduler_Request": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "parameters": {
                  "entityName": "crfdf_syncrequests",
                  "recordId": "@triggerOutputs()?['body/crfdf_syncrequestid']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "DeleteRecord"
                }
              }
            }
          },
          "else": {
            "actions": {
              "Mark_Done": {
                "type": "OpenApiConnection",
                "runAfter": {},
                "inputs": {
                  "parameters": {
                    "entityName": "crfdf_syncrequests",
                    "recordId": "@triggerOutputs()?['body/crfdf_syncrequestid']",
                    "item/crfdf_status": "Done",
                    "item/crfdf_result": "@if(equals(length(coalesce(body('Get_New_Completions')?['value'], json('[]'))), 0), 'No new shop-floor ticks', concat(string(length(coalesce(body('Get_New_Completions')?['value'], json('[]')))), if(equals(length(coalesce(body('Get_New_Completions')?['value'], json('[]'))), 1), ' new shop-floor tick', ' new shop-floor ticks')))"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "UpdateOnlyRecord"
                  }
                }
              }
            }
          }
        },
        "Mark_Failed": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Check_BC": [
              "Failed",
              "TimedOut"
            ]
          },
          "inputs": {
            "parameters": {
              "entityName": "crfdf_syncrequests",
              "recordId": "@triggerOutputs()?['body/crfdf_syncrequestid']",
              "item/crfdf_status": "Failed",
              "item/crfdf_result": "@'Could not check BC - see the flow run history.'"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateOnlyRecord"
            }
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
