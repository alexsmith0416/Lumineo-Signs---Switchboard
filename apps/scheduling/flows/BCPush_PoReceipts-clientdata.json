{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_4a52d"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "comment": "BCPush_PoReceipts - GENERATED by _gen_poreceiving_flows.py; edit that, not this. A PO's Vendor Status (crfdf_poreceipt) from the Switchboard app's Warehouse Management into BC (LUM PO Receipt, API poReceipts) for the Purchase Order card and Job Card. See BCPush_PoReceiving.md.",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Bc_ApiBase": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com/v2.0/fe0182fa-d183-46ab-8493-9e8ea9c3d0b8/UAT/api"
        },
        "Bc_CompanyId": {
          "type": "String",
          "defaultValue": "4738bfb5-a06d-ec11-bf27-000d3a132a9e"
        },
        "Bc_Tenant": {
          "type": "String",
          "defaultValue": "fe0182fa-d183-46ab-8493-9e8ea9c3d0b8"
        },
        "Bc_Audience": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com"
        },
        "Bc_ClientId": {
          "type": "String",
          "defaultValue": "<< Postman app registration client id >>"
        },
        "Bc_ClientSecret": {
          "type": "String",
          "defaultValue": "<< store in Key Vault / secure env var - do NOT commit >>"
        }
      },
      "triggers": {
        "When_a_row_changes": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "crfdf_poreceipt",
              "subscriptionRequest/scope": 4
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Get_Receipt": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "parameters": {
              "entityName": "crfdf_poreceipts",
              "$select": "crfdf_pono,crfdf_jobno,crfdf_vendorstatus,crfdf_statusby,crfdf_statusat",
              "$filter": "crfdf_poreceiptid eq @{triggerOutputs()?['body/crfdf_poreceiptid']}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            }
          }
        },
        "Row_Still_There": {
          "type": "If",
          "runAfter": {
            "Get_Receipt": [
              "Succeeded"
            ]
          },
          "expression": {
            "greater": [
              "@length(body('Get_Receipt')?['value'])",
              0
            ]
          },
          "actions": {
            "Body": {
              "type": "Compose",
              "runAfter": {},
              "inputs": "@if(empty(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_statusat'], ''))), addProperty(addProperty(addProperty(json('{}'), 'jobNo', toUpper(take(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_jobno'], '')), 20))), 'vendorStatus', take(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_vendorstatus'], '')), 30)), 'statusBy', take(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_statusby'], '')), 100)), addProperty(addProperty(addProperty(addProperty(json('{}'), 'jobNo', toUpper(take(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_jobno'], '')), 20))), 'vendorStatus', take(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_vendorstatus'], '')), 30)), 'statusBy', take(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_statusby'], '')), 100)), 'statusAt', trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_statusat'], ''))))"
            },
            "Find_In_BC": {
              "type": "Http",
              "runAfter": {
                "Body": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "method": "GET",
                "uri": "@{parameters('Bc_ApiBase')}/lumineo/planning/v1.0/companies(@{parameters('Bc_CompanyId')})/poReceipts?$filter=@{encodeUriComponent(concat('poNo eq ''', replace(toUpper(take(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_pono'], '')), 20)), '''', ''''''), ''''))}",
                "headers": {
                  "Accept": "application/json"
                },
                "authentication": {
                  "type": "ActiveDirectoryOAuth",
                  "authority": "https://login.microsoftonline.com",
                  "tenant": "@parameters('Bc_Tenant')",
                  "audience": "@parameters('Bc_Audience')",
                  "clientId": "@parameters('Bc_ClientId')",
                  "secret": "@parameters('Bc_ClientSecret')"
                }
              }
            },
            "In_BC_Already": {
              "type": "If",
              "runAfter": {
                "Find_In_BC": [
                  "Succeeded"
                ]
              },
              "expression": {
                "greater": [
                  "@length(body('Find_In_BC')?['value'])",
                  0
                ]
              },
              "actions": {
                "Update_In_BC": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "PATCH",
                    "uri": "@{parameters('Bc_ApiBase')}/lumineo/planning/v1.0/companies(@{parameters('Bc_CompanyId')})/poReceipts('@{encodeUriComponent(replace(toUpper(take(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_pono'], '')), 20)), '''', ''''''))}')",
                    "headers": {
                      "Accept": "application/json",
                      "Content-Type": "application/json",
                      "If-Match": "*"
                    },
                    "authentication": {
                      "type": "ActiveDirectoryOAuth",
                      "authority": "https://login.microsoftonline.com",
                      "tenant": "@parameters('Bc_Tenant')",
                      "audience": "@parameters('Bc_Audience')",
                      "clientId": "@parameters('Bc_ClientId')",
                      "secret": "@parameters('Bc_ClientSecret')"
                    },
                    "body": "@outputs('Body')"
                  }
                }
              },
              "else": {
                "actions": {
                  "Add_To_BC": {
                    "type": "Http",
                    "runAfter": {},
                    "inputs": {
                      "method": "POST",
                      "uri": "@{parameters('Bc_ApiBase')}/lumineo/planning/v1.0/companies(@{parameters('Bc_CompanyId')})/poReceipts",
                      "headers": {
                        "Accept": "application/json",
                        "Content-Type": "application/json"
                      },
                      "authentication": {
                        "type": "ActiveDirectoryOAuth",
                        "authority": "https://login.microsoftonline.com",
                        "tenant": "@parameters('Bc_Tenant')",
                        "audience": "@parameters('Bc_Audience')",
                        "clientId": "@parameters('Bc_ClientId')",
                        "secret": "@parameters('Bc_ClientSecret')"
                      },
                      "body": "@addProperty(outputs('Body'), 'poNo', toUpper(take(trim(coalesce(first(body('Get_Receipt')?['value'])?['crfdf_pono'], '')), 20)))"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
