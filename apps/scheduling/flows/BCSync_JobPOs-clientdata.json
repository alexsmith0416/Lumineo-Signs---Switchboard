{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_4a52d"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "comment": "BCSync_JobPOs - GENERATED by _gen_jobpos_flow.py; edit that, not this. Nightly: each open job's purchase orders (open + archived) from our BC API queries into crfdf_jobpo, writing only what changed. See BCSync_JobPOs.md.",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Bc_ApiBase": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com/v2.0/fe0182fa-d183-46ab-8493-9e8ea9c3d0b8/UAT/api"
        },
        "Bc_CompanyId": {
          "type": "String",
          "defaultValue": "4738bfb5-a06d-ec11-bf27-000d3a132a9e"
        },
        "Bc_Tenant": {
          "type": "String",
          "defaultValue": "fe0182fa-d183-46ab-8493-9e8ea9c3d0b8"
        },
        "Bc_Audience": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com"
        },
        "Bc_ClientId": {
          "type": "String",
          "defaultValue": "<< Postman app registration client id >>"
        },
        "Bc_ClientSecret": {
          "type": "String",
          "defaultValue": "<< store in Key Vault / secure env var - do NOT commit >>"
        }
      },
      "triggers": {
        "Nightly": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "timeZone": "Central Standard Time",
            "schedule": {
              "hours": [
                "5"
              ],
              "minutes": [
                15
              ]
            }
          }
        }
      },
      "actions": {
        "Get_Open_POs": {
          "type": "Http",
          "runAfter": {},
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('Bc_ApiBase')}/lumineo/planning/v1.0/companies(@{parameters('Bc_CompanyId')})/jobPurchaseOrders",
            "headers": {
              "Accept": "application/json"
            },
            "authentication": {
              "type": "ActiveDirectoryOAuth",
              "authority": "https://login.microsoftonline.com",
              "tenant": "@parameters('Bc_Tenant')",
              "audience": "@parameters('Bc_Audience')",
              "clientId": "@parameters('Bc_ClientId')",
              "secret": "@parameters('Bc_ClientSecret')"
            }
          }
        },
        "Get_Archived_POs": {
          "type": "Http",
          "runAfter": {},
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('Bc_ApiBase')}/lumineo/planning/v1.0/companies(@{parameters('Bc_CompanyId')})/jobPurchaseOrderArchives",
            "headers": {
              "Accept": "application/json"
            },
            "authentication": {
              "type": "ActiveDirectoryOAuth",
              "authority": "https://login.microsoftonline.com",
              "tenant": "@parameters('Bc_Tenant')",
              "audience": "@parameters('Bc_Audience')",
              "clientId": "@parameters('Bc_ClientId')",
              "secret": "@parameters('Bc_ClientSecret')"
            }
          }
        },
        "List_BC_Jobs": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "parameters": {
              "entityName": "crfdf_bcjobs",
              "$select": "crfdf_jobnumber",
              "$filter": "crfdf_jobnumber ne null"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 100000
            }
          }
        },
        "List_Existing": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "parameters": {
              "entityName": "crfdf_jobpos",
              "$select": "crfdf_jobpoid,crfdf_name,crfdf_vendorno,crfdf_vendorname,crfdf_orderdate,crfdf_postatus"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 100000
            }
          }
        },
        "Check_Single_Page": {
          "type": "If",
          "runAfter": {
            "Get_Open_POs": [
              "Succeeded"
            ],
            "Get_Archived_POs": [
              "Succeeded"
            ]
          },
          "expression": {
            "or": [
              {
                "not": {
                  "equals": [
                    "@empty(coalesce(body('Get_Open_POs')?['@odata.nextLink'], ''))",
                    true
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@empty(coalesce(body('Get_Archived_POs')?['@odata.nextLink'], ''))",
                    true
                  ]
                }
              }
            ]
          },
          "actions": {
            "Stop_Paged": {
              "type": "Terminate",
              "runAfter": {},
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "Paged",
                  "message": "BC returned more than one page - add paging to BCSync_JobPOs."
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Open_Rows": {
          "type": "Select",
          "runAfter": {
            "Check_Single_Page": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Get_Open_POs')?['value']",
            "select": {
              "k": "@concat(trim(coalesce(item()?['jobNo'], '')), '|', trim(coalesce(item()?['documentNo'], '')))",
              "jobNo": "@trim(coalesce(item()?['jobNo'], ''))",
              "poNo": "@trim(coalesce(item()?['documentNo'], ''))",
              "vendorNo": "@coalesce(item()?['buyFromVendorNo'], '')",
              "vendorName": "@coalesce(item()?['buyFromVendorName'], '')",
              "orderDate": "@if(startsWith(coalesce(item()?['orderDate'], ''), '0001'), '', coalesce(item()?['orderDate'], ''))",
              "status": "@replace(coalesce(item()?['status'], 'Open'), '_x0020_', ' ')",
              "rank": "@1000000",
              "sig": "@concat(concat(trim(coalesce(item()?['jobNo'], '')), '|', trim(coalesce(item()?['documentNo'], ''))), '~', coalesce(item()?['buyFromVendorNo'], ''), '~', coalesce(item()?['buyFromVendorName'], ''), '~', coalesce(if(startsWith(coalesce(item()?['orderDate'], ''), '0001'), '', coalesce(item()?['orderDate'], '')), ''), '~', coalesce(replace(coalesce(item()?['status'], 'Open'), '_x0020_', ' '), ''))"
            }
          }
        },
        "Archived_Rows": {
          "type": "Select",
          "runAfter": {
            "Check_Single_Page": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Get_Archived_POs')?['value']",
            "select": {
              "k": "@concat(trim(coalesce(item()?['jobNo'], '')), '|', trim(coalesce(item()?['documentNo'], '')))",
              "jobNo": "@trim(coalesce(item()?['jobNo'], ''))",
              "poNo": "@trim(coalesce(item()?['documentNo'], ''))",
              "vendorNo": "@coalesce(item()?['buyFromVendorNo'], '')",
              "vendorName": "@coalesce(item()?['buyFromVendorName'], '')",
              "orderDate": "@if(startsWith(coalesce(item()?['orderDate'], ''), '0001'), '', coalesce(item()?['orderDate'], ''))",
              "status": "@'Archived'",
              "rank": "@int(coalesce(item()?['versionNo'], 0))",
              "sig": "@concat(concat(trim(coalesce(item()?['jobNo'], '')), '|', trim(coalesce(item()?['documentNo'], ''))), '~', coalesce(item()?['buyFromVendorNo'], ''), '~', coalesce(item()?['buyFromVendorName'], ''), '~', coalesce(if(startsWith(coalesce(item()?['orderDate'], ''), '0001'), '', coalesce(item()?['orderDate'], '')), ''), '~', coalesce('Archived', ''))"
            }
          }
        },
        "Job_Numbers": {
          "type": "Select",
          "runAfter": {
            "List_BC_Jobs": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_BC_Jobs')?['value']",
            "select": "@trim(coalesce(item()?['crfdf_jobnumber'], ''))"
          }
        },
        "Job_Text": {
          "type": "Compose",
          "runAfter": {
            "Job_Numbers": [
              "Succeeded"
            ]
          },
          "inputs": "@concat('^', join(body('Job_Numbers'), '^'), '^')"
        },
        "Wanted_Rows": {
          "type": "Query",
          "runAfter": {
            "Open_Rows": [
              "Succeeded"
            ],
            "Archived_Rows": [
              "Succeeded"
            ],
            "Job_Text": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@union(body('Open_Rows'), body('Archived_Rows'))",
            "where": "@and(not(empty(item()?['poNo'])), contains(outputs('Job_Text'), concat('^', item()?['jobNo'], '^')))"
          }
        },
        "Existing_Sigs": {
          "type": "Select",
          "runAfter": {
            "List_Existing": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_Existing')?['value']",
            "select": "@concat(item()?['crfdf_name'], '~', coalesce(item()?['crfdf_vendorno'], ''), '~', coalesce(item()?['crfdf_vendorname'], ''), '~', coalesce(item()?['crfdf_orderdate'], ''), '~', coalesce(item()?['crfdf_postatus'], ''))"
          }
        },
        "Existing_Sig_Text": {
          "type": "Compose",
          "runAfter": {
            "Existing_Sigs": [
              "Succeeded"
            ]
          },
          "inputs": "@concat('^', join(body('Existing_Sigs'), '^'), '^')"
        },
        "Changed_Rows": {
          "type": "Query",
          "runAfter": {
            "Wanted_Rows": [
              "Succeeded"
            ],
            "Existing_Sig_Text": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Wanted_Rows')",
            "where": "@not(contains(outputs('Existing_Sig_Text'), concat('^', item()?['sig'], '^')))"
          }
        },
        "Changed_Keys": {
          "type": "Select",
          "runAfter": {
            "Changed_Rows": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Changed_Rows')",
            "select": "@item()?['k']"
          }
        },
        "For_each_changed_key": {
          "type": "Foreach",
          "foreach": "@union(body('Changed_Keys'), body('Changed_Keys'))",
          "runAfter": {
            "Changed_Keys": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 10
            }
          },
          "actions": {
            "Same_Key": {
              "type": "Query",
              "runAfter": {},
              "inputs": {
                "from": "@body('Wanted_Rows')",
                "where": "@equals(item()?['k'], items('For_each_changed_key'))"
              }
            },
            "Winner": {
              "type": "Compose",
              "runAfter": {
                "Same_Key": [
                  "Succeeded"
                ]
              },
              "inputs": "@last(sort(body('Same_Key'), 'rank'))"
            },
            "Existing_Row": {
              "type": "Query",
              "runAfter": {
                "Winner": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('List_Existing')?['value']",
                "where": "@equals(item()?['crfdf_name'], items('For_each_changed_key'))"
              }
            },
            "Row_Exists": {
              "type": "If",
              "runAfter": {
                "Existing_Row": [
                  "Succeeded"
                ]
              },
              "expression": {
                "greater": [
                  "@length(body('Existing_Row'))",
                  0
                ]
              },
              "actions": {
                "Differs": {
                  "type": "If",
                  "runAfter": {},
                  "expression": {
                    "not": {
                      "equals": [
                        "@outputs('Winner')?['sig']",
                        "@concat(first(body('Existing_Row'))?['crfdf_name'], '~', coalesce(first(body('Existing_Row'))?['crfdf_vendorno'], ''), '~', coalesce(first(body('Existing_Row'))?['crfdf_vendorname'], ''), '~', coalesce(first(body('Existing_Row'))?['crfdf_orderdate'], ''), '~', coalesce(first(body('Existing_Row'))?['crfdf_postatus'], ''))"
                      ]
                    }
                  },
                  "actions": {
                    "Update_PO": {
                      "type": "OpenApiConnection",
                      "runAfter": {},
                      "inputs": {
                        "parameters": {
                          "entityName": "crfdf_jobpos",
                          "recordId": "@first(body('Existing_Row'))?['crfdf_jobpoid']",
                          "item/crfdf_name": "@outputs('Winner')?['k']",
                          "item/crfdf_jobno": "@outputs('Winner')?['jobNo']",
                          "item/crfdf_pono": "@outputs('Winner')?['poNo']",
                          "item/crfdf_vendorno": "@outputs('Winner')?['vendorNo']",
                          "item/crfdf_vendorname": "@outputs('Winner')?['vendorName']",
                          "item/crfdf_orderdate": "@outputs('Winner')?['orderDate']",
                          "item/crfdf_postatus": "@outputs('Winner')?['status']"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateOnlyRecord"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              },
              "else": {
                "actions": {
                  "Create_PO": {
                    "type": "OpenApiConnection",
                    "runAfter": {},
                    "inputs": {
                      "parameters": {
                        "entityName": "crfdf_jobpos",
                        "item/crfdf_name": "@outputs('Winner')?['k']",
                        "item/crfdf_jobno": "@outputs('Winner')?['jobNo']",
                        "item/crfdf_pono": "@outputs('Winner')?['poNo']",
                        "item/crfdf_vendorno": "@outputs('Winner')?['vendorNo']",
                        "item/crfdf_vendorname": "@outputs('Winner')?['vendorName']",
                        "item/crfdf_orderdate": "@outputs('Winner')?['orderDate']",
                        "item/crfdf_postatus": "@outputs('Winner')?['status']"
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "CreateRecord"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "Wanted_Keys": {
          "type": "Select",
          "runAfter": {
            "Wanted_Rows": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Wanted_Rows')",
            "select": "@item()?['k']"
          }
        },
        "Wanted_Key_Text": {
          "type": "Compose",
          "runAfter": {
            "Wanted_Keys": [
              "Succeeded"
            ]
          },
          "inputs": "@concat('^', join(body('Wanted_Keys'), '^'), '^')"
        },
        "Stale_Rows": {
          "type": "Query",
          "runAfter": {
            "Wanted_Key_Text": [
              "Succeeded"
            ],
            "List_Existing": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_Existing')?['value']",
            "where": "@not(contains(outputs('Wanted_Key_Text'), concat('^', coalesce(item()?['crfdf_name'], ''), '^')))"
          }
        },
        "Any_Wanted": {
          "type": "If",
          "runAfter": {
            "Stale_Rows": [
              "Succeeded"
            ],
            "For_each_changed_key": [
              "Succeeded"
            ]
          },
          "expression": {
            "greater": [
              "@length(body('Wanted_Rows'))",
              0
            ]
          },
          "actions": {
            "For_each_stale_row": {
              "type": "Foreach",
              "foreach": "@body('Stale_Rows')",
              "runAfter": {},
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 10
                }
              },
              "actions": {
                "Delete_PO": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "parameters": {
                      "entityName": "crfdf_jobpos",
                      "recordId": "@items('For_each_stale_row')?['crfdf_jobpoid']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "DeleteRecord"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
