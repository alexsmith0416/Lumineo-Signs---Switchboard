{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_4a52d"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "comment": "BCSync_JobDescriptions - GENERATED by _gen_jobdesc_flow.py; edit that, not this. Hourly: each open job's Field / Production / Extended Description from our BC API page into crfdf_jobdesc, writing only jobs whose BC lastModified changed. See BCSync_JobDescriptions.md.",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Bc_ApiBase": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com/v2.0/fe0182fa-d183-46ab-8493-9e8ea9c3d0b8/UAT/api"
        },
        "Bc_CompanyId": {
          "type": "String",
          "defaultValue": "4738bfb5-a06d-ec11-bf27-000d3a132a9e"
        },
        "Bc_Tenant": {
          "type": "String",
          "defaultValue": "fe0182fa-d183-46ab-8493-9e8ea9c3d0b8"
        },
        "Bc_Audience": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com"
        },
        "Bc_ClientId": {
          "type": "String",
          "defaultValue": "<< Postman app registration client id >>"
        },
        "Bc_ClientSecret": {
          "type": "String",
          "defaultValue": "<< store in Key Vault / secure env var - do NOT commit >>"
        }
      },
      "triggers": {
        "Hourly": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Hour",
            "interval": 1
          }
        }
      },
      "actions": {
        "Get_Descriptions": {
          "type": "Http",
          "runAfter": {},
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('Bc_ApiBase')}/lumineo/planning/v1.0/companies(@{parameters('Bc_CompanyId')})/jobDescriptions?$filter=@{encodeUriComponent('status eq ''Open''')}&$select=jobNo,lastModified,fieldDescription,productionDescription,extendedDescription",
            "headers": {
              "Accept": "application/json"
            },
            "authentication": {
              "type": "ActiveDirectoryOAuth",
              "authority": "https://login.microsoftonline.com",
              "tenant": "@parameters('Bc_Tenant')",
              "audience": "@parameters('Bc_Audience')",
              "clientId": "@parameters('Bc_ClientId')",
              "secret": "@parameters('Bc_ClientSecret')"
            }
          }
        },
        "List_Existing": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "parameters": {
              "entityName": "crfdf_jobdescs",
              "$select": "crfdf_jobdescid,crfdf_jobno,crfdf_bcmodified"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 100000
            }
          }
        },
        "Check_Single_Page": {
          "type": "If",
          "runAfter": {
            "Get_Descriptions": [
              "Succeeded"
            ]
          },
          "expression": {
            "not": {
              "equals": [
                "@empty(coalesce(body('Get_Descriptions')?['@odata.nextLink'], ''))",
                true
              ]
            }
          },
          "actions": {
            "Stop_Paged": {
              "type": "Terminate",
              "runAfter": {},
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "Paged",
                  "message": "BC returned more than one page - add paging to BCSync_JobDescriptions."
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Jobs": {
          "type": "Query",
          "runAfter": {
            "Check_Single_Page": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Get_Descriptions')?['value']",
            "where": "@not(empty(trim(coalesce(item()?['jobNo'], ''))))"
          }
        },
        "Existing_Stamps": {
          "type": "Select",
          "runAfter": {
            "List_Existing": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_Existing')?['value']",
            "select": "@concat(trim(coalesce(item()?['crfdf_jobno'], '')), '~', coalesce(item()?['crfdf_bcmodified'], ''))"
          }
        },
        "Existing_Stamp_Text": {
          "type": "Compose",
          "runAfter": {
            "Existing_Stamps": [
              "Succeeded"
            ]
          },
          "inputs": "@concat('^', join(body('Existing_Stamps'), '^'), '^')"
        },
        "Changed_Jobs": {
          "type": "Query",
          "runAfter": {
            "Jobs": [
              "Succeeded"
            ],
            "Existing_Stamp_Text": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Jobs')",
            "where": "@not(contains(outputs('Existing_Stamp_Text'), concat('^', concat(trim(coalesce(item()?['jobNo'], '')), '~', coalesce(item()?['lastModified'], '')), '^')))"
          }
        },
        "For_each_changed_job": {
          "type": "Foreach",
          "foreach": "@body('Changed_Jobs')",
          "runAfter": {
            "Changed_Jobs": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 10
            }
          },
          "actions": {
            "Existing_Row": {
              "type": "Query",
              "runAfter": {},
              "inputs": {
                "from": "@body('List_Existing')?['value']",
                "where": "@equals(trim(coalesce(item()?['crfdf_jobno'], '')), trim(items('For_each_changed_job')?['jobNo']))"
              }
            },
            "Row_Exists": {
              "type": "If",
              "runAfter": {
                "Existing_Row": [
                  "Succeeded"
                ]
              },
              "expression": {
                "greater": [
                  "@length(body('Existing_Row'))",
                  0
                ]
              },
              "actions": {
                "Update_Descriptions": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "parameters": {
                      "entityName": "crfdf_jobdescs",
                      "recordId": "@first(body('Existing_Row'))?['crfdf_jobdescid']",
                      "item/crfdf_name": "@trim(items('For_each_changed_job')?['jobNo'])",
                      "item/crfdf_jobno": "@trim(items('For_each_changed_job')?['jobNo'])",
                      "item/crfdf_fielddesc": "@coalesce(items('For_each_changed_job')?['fieldDescription'], '')",
                      "item/crfdf_proddesc": "@coalesce(items('For_each_changed_job')?['productionDescription'], '')",
                      "item/crfdf_extdesc": "@coalesce(items('For_each_changed_job')?['extendedDescription'], '')",
                      "item/crfdf_bcmodified": "@coalesce(items('For_each_changed_job')?['lastModified'], '')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord"
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Create_Descriptions": {
                    "type": "OpenApiConnection",
                    "runAfter": {},
                    "inputs": {
                      "parameters": {
                        "entityName": "crfdf_jobdescs",
                        "item/crfdf_name": "@trim(items('For_each_changed_job')?['jobNo'])",
                        "item/crfdf_jobno": "@trim(items('For_each_changed_job')?['jobNo'])",
                        "item/crfdf_fielddesc": "@coalesce(items('For_each_changed_job')?['fieldDescription'], '')",
                        "item/crfdf_proddesc": "@coalesce(items('For_each_changed_job')?['productionDescription'], '')",
                        "item/crfdf_extdesc": "@coalesce(items('For_each_changed_job')?['extendedDescription'], '')",
                        "item/crfdf_bcmodified": "@coalesce(items('For_each_changed_job')?['lastModified'], '')"
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "CreateRecord"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "Open_Job_Numbers": {
          "type": "Select",
          "runAfter": {
            "Jobs": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Jobs')",
            "select": "@trim(coalesce(item()?['jobNo'], ''))"
          }
        },
        "Open_Job_Text": {
          "type": "Compose",
          "runAfter": {
            "Open_Job_Numbers": [
              "Succeeded"
            ]
          },
          "inputs": "@concat('^', join(body('Open_Job_Numbers'), '^'), '^')"
        },
        "Stale_Rows": {
          "type": "Query",
          "runAfter": {
            "Open_Job_Text": [
              "Succeeded"
            ],
            "List_Existing": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_Existing')?['value']",
            "where": "@not(contains(outputs('Open_Job_Text'), concat('^', trim(coalesce(item()?['crfdf_jobno'], '')), '^')))"
          }
        },
        "Any_Jobs": {
          "type": "If",
          "runAfter": {
            "Stale_Rows": [
              "Succeeded"
            ],
            "For_each_changed_job": [
              "Succeeded"
            ]
          },
          "expression": {
            "greater": [
              "@length(body('Jobs'))",
              0
            ]
          },
          "actions": {
            "For_each_stale_row": {
              "type": "Foreach",
              "foreach": "@body('Stale_Rows')",
              "runAfter": {},
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 10
                }
              },
              "actions": {
                "Delete_Descriptions": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "parameters": {
                      "entityName": "crfdf_jobdescs",
                      "recordId": "@items('For_each_stale_row')?['crfdf_jobdescid']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "DeleteRecord"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
