{
  "properties": {
    "connectionReferences": {
      "shared_dynamicssmbsaas": {
        "api": {
          "name": "shared_dynamicssmbsaas"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_shareddynamicssmbsaas_69260"
        },
        "runtimeSource": "embedded"
      },
      "shared_commondataserviceforapps-1": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_4a52d"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Day",
            "timeZone": "Central Standard Time",
            "schedule": {
              "hours": [
                "0"
              ],
              "minutes": [
                0
              ]
            }
          }
        }
      },
      "actions": {
        "Jobs": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "bcenvironment": "PRODUCTION",
              "company": "4738bfb5-a06d-ec11-bf27-000d3a132a9e",
              "dataset": "microsoft/analytics/v1.0",
              "table": "jobs",
              "$filter": "status eq 'Open' and complete eq false and no ne '1NON-JOBLABOR'"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_dynamicssmbsaas",
              "operationId": "GetItemsV3",
              "connectionName": "shared_dynamicssmbsaas"
            }
          },
          "runAfter": {},
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          }
        },
        "Apply_to_each": {
          "type": "Foreach",
          "foreach": "@outputs('Jobs')?['body/value']",
          "actions": {
            "Update_a_row": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "crfdf_bcjobs",
                  "recordId": "@first(outputs('List_rows')?['body/value'])?['crfdf_bcjobid']",
                  "item/crfdf_billtocustomerno": "@items('Apply_to_each')?['billToCustomerNo']",
                  "item/crfdf_customername": "@coalesce(first(body('Filter_array'))?['crfdf_customername'], items('Apply_to_each')?['no'])",
                  "item/crfdf_description": "@items('Apply_to_each')?['description']",
                  "item/crfdf_jobnumber": "@items('Apply_to_each')?['no']",
                  "item/crfdf_promiseddate": "@if(or(empty(coalesce(items('Apply_to_each')?['endingDate'],'')), startsWith(coalesce(items('Apply_to_each')?['endingDate'],''),'0001')), null, items('Apply_to_each')?['endingDate'])",
                  "item/crfdf_shiptoaddress": "@first(body('Filter_array'))?['crfdf_addressline1']",
                  "item/crfdf_shiptocity": "@first(body('Filter_array'))?['crfdf_city']",
                  "item/crfdf_shiptostate": "@first(body('Filter_array'))?['crfdf_state']",
                  "item/crfdf_shiptozip": "@first(body('Filter_array'))?['crfdf_postalcode']",
                  "item/crfdf_status": "@items('Apply_to_each')?['status']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "connectionName": "shared_commondataserviceforapps-1"
                }
              },
              "runAfter": {
                "List_rows": [
                  "Succeeded"
                ]
              }
            },
            "Add_a_new_row": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "crfdf_bcjobs",
                  "item/crfdf_billtocustomerno": "@items('Apply_to_each')?['billToCustomerNo']",
                  "item/crfdf_customername": "@coalesce(first(body('Filter_array'))?['crfdf_customername'], items('Apply_to_each')?['no'])",
                  "item/crfdf_description": "@items('Apply_to_each')?['description']",
                  "item/crfdf_jobnumber": "@items('Apply_to_each')?['no']",
                  "item/crfdf_promiseddate": "@if(or(empty(coalesce(items('Apply_to_each')?['endingDate'],'')), startsWith(coalesce(items('Apply_to_each')?['endingDate'],''),'0001')), null, items('Apply_to_each')?['endingDate'])",
                  "item/crfdf_shiptoaddress": "@first(body('Filter_array'))?['crfdf_addressline1']",
                  "item/crfdf_shiptocity": "@first(body('Filter_array'))?['crfdf_city']",
                  "item/crfdf_shiptostate": "@first(body('Filter_array'))?['crfdf_state']",
                  "item/crfdf_shiptozip": "@first(body('Filter_array'))?['crfdf_postalcode']",
                  "item/crfdf_status": "@items('Apply_to_each')?['status']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "connectionName": "shared_commondataserviceforapps-1"
                }
              },
              "runAfter": {
                "Update_a_row": [
                  "Failed"
                ]
              }
            },
            "List_rows": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "crfdf_bcjobs",
                  "$filter": "crfdf_jobnumber eq '@{items('Apply_to_each')?['no']}'",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps-1"
                }
              },
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              }
            },
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@outputs('Customers')?['body/value']",
                "where": "@equals(item()?['crfdf_customerno'],items('Apply_to_each')?['billToCustomerNo'])"
              }
            },
            "List_JobSchedule": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "crfdf_jobschedules",
                  "$filter": "crfdf_jobno eq '@{items('Apply_to_each')?['no']}'",
                  "$select": "crfdf_jobscheduleid,crfdf_releaseddate",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps-1"
                }
              },
              "runAfter": {}
            },
            "Stamp_release_date_if_missing": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@empty(coalesce(first(outputs('List_JobSchedule')?['body/value'])?['crfdf_releaseddate'], ''))",
                      true
                    ]
                  }
                ]
              },
              "actions": {
                "Update_JobSchedule_release": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "crfdf_jobschedules",
                      "recordId": "@first(outputs('List_JobSchedule')?['body/value'])?['crfdf_jobscheduleid']",
                      "item/crfdf_releaseddate": "@formatDateTime(convertFromUtc(utcNow(),'Central Standard Time'),'yyyy-MM-dd')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "connectionName": "shared_commondataserviceforapps-1"
                    }
                  },
                  "runAfter": {}
                },
                "Add_JobSchedule_release": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "crfdf_jobschedules",
                      "item/crfdf_jobno": "@items('Apply_to_each')?['no']",
                      "item/crfdf_name": "@items('Apply_to_each')?['no']",
                      "item/crfdf_releaseddate": "@formatDateTime(convertFromUtc(utcNow(),'Central Standard Time'),'yyyy-MM-dd')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "connectionName": "shared_commondataserviceforapps-1"
                    }
                  },
                  "runAfter": {
                    "Update_JobSchedule_release": [
                      "Failed"
                    ]
                  }
                }
              },
              "runAfter": {
                "List_JobSchedule": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Customers": [
              "Succeeded"
            ]
          }
        },
        "Customers": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "crfdf_bccustomers",
              "$select": "crfdf_customerno,crfdf_customername,crfdf_addressline1,crfdf_city,crfdf_state,crfdf_postalcode"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "connectionName": "shared_commondataserviceforapps-1"
            }
          },
          "runAfter": {
            "Jobs": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          }
        }
      },
      "description": "Nightly sync of BC analytics jobs into crfdf_bcjobs (upsert by job number; bill-to customer name + ship-to joined from crfdf_bccustomers; promised date from endingDate). Also stamps crfdf_jobschedule.releaseddate write-once when a job is first seen at status Open (the release anchor for scheduling targets). Built by agent. #flowstudio-mcp"
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}