{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_4a52d"
        },
        "runtimeSource": "embedded"
      },
      "shared_sharepointonline": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "lum_sharedsharepointonline_jobsketches"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "comment": "BCSync_JobSketches - GENERATED by _gen_jobsketches_flow.py; edit that, not this. Finds each open job's sketch in its SharePoint folder (newest PDF named with the job number, else the newest image) and saves its link + a thumbnail to crfdf_jobsketch for the Jobs list Sketch column. See BCSync_JobSketches.md.",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Sp_Site": {
          "type": "String",
          "defaultValue": "https://luminousneon.sharepoint.com/sites/JobFiles"
        },
        "Sp_Library_Path": {
          "type": "String",
          "defaultValue": "/sites/JobFiles/Shared Documents"
        },
        "Thumb_Size": {
          "type": "String",
          "defaultValue": "c320x240"
        },
        "Only_Job": {
          "type": "String",
          "defaultValue": ""
        }
      },
      "triggers": {
        "Nightly": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "timeZone": "Central Standard Time",
            "schedule": {
              "hours": [
                "4"
              ],
              "minutes": [
                30
              ]
            }
          }
        }
      },
      "actions": {
        "List_Jobs": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "parameters": {
              "entityName": "crfdf_bcjobs",
              "$select": "crfdf_jobnumber,crfdf_sharepointurl",
              "$filter": "@{if(empty(parameters('Only_Job')), 'crfdf_sharepointurl ne null and crfdf_status eq ''Open''', concat('crfdf_jobnumber eq ''', replace(parameters('Only_Job'), '''', ''''''), ''''))}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          }
        },
        "List_Sketches": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "parameters": {
              "entityName": "crfdf_jobsketchs",
              "$select": "crfdf_jobsketchid,crfdf_jobno,crfdf_fileversion,crfdf_pinned"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          }
        },
        "Removed_Rows": {
          "type": "Query",
          "runAfter": {
            "List_Sketches": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_Sketches')?['value']",
            "where": "@equals(coalesce(item()?['crfdf_pinned'], ''), '(removed)')"
          }
        },
        "Removed_Jobs": {
          "type": "Select",
          "runAfter": {
            "Removed_Rows": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Removed_Rows')",
            "select": "@trim(coalesce(item()?['crfdf_jobno'], ''))"
          }
        },
        "Jobs_In_Site": {
          "type": "Query",
          "runAfter": {
            "List_Jobs": [
              "Succeeded"
            ],
            "Removed_Jobs": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_Jobs')?['value']",
            "where": "@and(startsWith(toLower(trim(coalesce(item()?['crfdf_sharepointurl'], ''))), toLower(concat(parameters('Sp_Site'), '/'))), not(contains(body('Removed_Jobs'), trim(coalesce(item()?['crfdf_jobnumber'], '')))))"
          }
        },
        "For_each_job": {
          "type": "Foreach",
          "foreach": "@body('Jobs_In_Site')",
          "runAfter": {
            "Jobs_In_Site": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 8
            }
          },
          "actions": {
            "Try_Job": {
              "type": "Scope",
              "runAfter": {},
              "actions": {
                "Server_Relative_Folder": {
                  "type": "Compose",
                  "runAfter": {},
                  "inputs": "@concat('/', join(skip(split(trim(items('For_each_job')?['crfdf_sharepointurl']), '/'), 3), '/'))"
                },
                "List_Body": {
                  "type": "Compose",
                  "runAfter": {
                    "Server_Relative_Folder": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "parameters": {
                      "RenderOptions": 2,
                      "FolderServerRelativeUrl": "@{outputs('Server_Relative_Folder')}",
                      "ViewXml": "<View Scope=\"RecursiveAll\"><Query><Where><Eq><FieldRef Name=\"FSObjType\"/><Value Type=\"Integer\">0</Value></Eq></Where><OrderBy><FieldRef Name=\"Modified\" Ascending=\"FALSE\"/></OrderBy></Query><ViewFields><FieldRef Name=\"FileLeafRef\"/><FieldRef Name=\"FileRef\"/><FieldRef Name=\"File_x0020_Type\"/><FieldRef Name=\"Modified\"/><FieldRef Name=\"UniqueId\"/></ViewFields><RowLimit>1000</RowLimit></View>"
                    }
                  }
                },
                "List_Files": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "List_Body": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "parameters": {
                      "dataset": "@parameters('Sp_Site')",
                      "parameters/method": "POST",
                      "parameters/uri": "@{concat('_api/web/GetListUsingPath(DecodedUrl=@a1)/RenderListDataAsStream?@a1=''', encodeUriComponent(parameters('Sp_Library_Path')), '''')}",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata"
                      },
                      "parameters/body": "@{outputs('List_Body')}"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    }
                  }
                },
                "Sketch_PDFs": {
                  "type": "Query",
                  "runAfter": {
                    "List_Files": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@coalesce(body('List_Files')?['Row'], json('[]'))",
                    "where": "@and(equals(toLower(coalesce(item()?['File_x0020_Type'], '')), 'pdf'), startsWith(toLower(coalesce(item()?['FileLeafRef'], '')), toLower(trim(items('For_each_job')?['crfdf_jobnumber']))))"
                  }
                },
                "Images": {
                  "type": "Query",
                  "runAfter": {
                    "List_Files": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@coalesce(body('List_Files')?['Row'], json('[]'))",
                    "where": "@contains(createArray('jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'heic', 'tif', 'tiff'), toLower(coalesce(item()?['File_x0020_Type'], '')))"
                  }
                },
                "Existing_Sketch": {
                  "type": "Query",
                  "runAfter": {
                    "List_Files": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('List_Sketches')?['value']",
                    "where": "@equals(trim(coalesce(item()?['crfdf_jobno'], '')), trim(items('For_each_job')?['crfdf_jobnumber']))"
                  }
                },
                "Pinned_File": {
                  "type": "Query",
                  "runAfter": {
                    "Existing_Sketch": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@coalesce(body('List_Files')?['Row'], json('[]'))",
                    "where": "@and(not(empty(coalesce(first(body('Existing_Sketch'))?['crfdf_pinned'], ''))), equals(toLower(coalesce(item()?['FileRef'], '')), toLower(coalesce(first(body('Existing_Sketch'))?['crfdf_pinned'], ''))))"
                  }
                },
                "Pick_Sketch": {
                  "type": "Compose",
                  "runAfter": {
                    "Sketch_PDFs": [
                      "Succeeded"
                    ],
                    "Images": [
                      "Succeeded"
                    ],
                    "Pinned_File": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@if(greater(length(body('Pinned_File')), 0), first(body('Pinned_File')), if(greater(length(body('Sketch_PDFs')), 0), first(body('Sketch_PDFs')), first(body('Images'))))"
                },
                "Has_Sketch": {
                  "type": "If",
                  "runAfter": {
                    "Pick_Sketch": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "not": {
                      "equals": [
                        "@empty(outputs('Pick_Sketch'))",
                        true
                      ]
                    }
                  },
                  "actions": {
                    "Sketch_Changed": {
                      "type": "If",
                      "runAfter": {},
                      "expression": {
                        "or": [
                          {
                            "equals": [
                              "@empty(first(body('Existing_Sketch')))",
                              true
                            ]
                          },
                          {
                            "not": {
                              "equals": [
                                "@coalesce(first(body('Existing_Sketch'))?['crfdf_fileversion'], '')",
                                "@concat('v4|', outputs('Pick_Sketch')?['UniqueId'], '|', outputs('Pick_Sketch')?['Modified'])"
                              ]
                            }
                          }
                        ]
                      },
                      "actions": {
                        "Thumb_Info": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "parameters": {
                              "dataset": "@parameters('Sp_Site')",
                              "parameters/method": "GET",
                              "parameters/uri": "@{concat('_api/v2.0/drive/root:/', replace(encodeUriComponent(substring(outputs('Pick_Sketch')?['FileRef'], add(length(parameters('Sp_Library_Path')), 1))), '%2F', '/'), ':/thumbnails/0/', parameters('Thumb_Size'))}",
                              "parameters/headers": {
                                "Accept": "application/json;odata=nometadata",
                                "Content-Type": "application/json;odata=nometadata"
                              }
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "HttpRequest"
                            }
                          }
                        },
                        "Download_Thumbnail": {
                          "type": "Http",
                          "runAfter": {
                            "Thumb_Info": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "method": "GET",
                            "uri": "@body('Thumb_Info')?['url']"
                          }
                        },
                        "Save_Sketch": {
                          "type": "If",
                          "runAfter": {
                            "Thumb_Info": [
                              "Succeeded",
                              "Failed",
                              "Skipped"
                            ],
                            "Download_Thumbnail": [
                              "Succeeded",
                              "Failed",
                              "Skipped"
                            ]
                          },
                          "expression": {
                            "equals": [
                              "@empty(first(body('Existing_Sketch')))",
                              true
                            ]
                          },
                          "actions": {
                            "Create_Sketch": {
                              "type": "OpenApiConnection",
                              "runAfter": {},
                              "inputs": {
                                "parameters": {
                                  "entityName": "crfdf_jobsketchs",
                                  "item/crfdf_jobno": "@trim(items('For_each_job')?['crfdf_jobnumber'])",
                                  "item/crfdf_name": "@trim(items('For_each_job')?['crfdf_jobnumber'])",
                                  "item/crfdf_fileurl": "@concat(join(take(split(parameters('Sp_Site'), '/'), 3), '/'), replace(replace(replace(outputs('Pick_Sketch')?['FileRef'], '%', '%25'), ' ', '%20'), '#', '%23'))",
                                  "item/crfdf_filename": "@outputs('Pick_Sketch')?['FileLeafRef']",
                                  "item/crfdf_fileversion": "@if(and(equals(actions('Download_Thumbnail')?['status'], 'Succeeded'), not(empty(body('Download_Thumbnail')?['$content']))), concat('v4|', outputs('Pick_Sketch')?['UniqueId'], '|', outputs('Pick_Sketch')?['Modified']), concat(concat('v4|', outputs('Pick_Sketch')?['UniqueId'], '|', outputs('Pick_Sketch')?['Modified']), '|no-thumbnail'))",
                                  "item/crfdf_thumbnail": "@if(and(equals(actions('Download_Thumbnail')?['status'], 'Succeeded'), not(empty(body('Download_Thumbnail')?['$content']))), concat('data:', coalesce(body('Download_Thumbnail')?['$content-type'], 'image/jpeg'), ';base64,', body('Download_Thumbnail')?['$content']), concat('error: ', take(concat('Thumb_Info=', coalesce(actions('Thumb_Info')?['status'], ''), ' ', string(coalesce(actions('Thumb_Info')?['outputs']?['body'], actions('Thumb_Info')?['error'], '')), ' || ', 'Download_Thumbnail=', coalesce(actions('Download_Thumbnail')?['status'], ''), ' ', string(coalesce(actions('Download_Thumbnail')?['outputs']?['body'], actions('Download_Thumbnail')?['error'], ''))), 3000)))"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "CreateRecord"
                                }
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Update_Sketch": {
                                "type": "OpenApiConnection",
                                "runAfter": {},
                                "inputs": {
                                  "parameters": {
                                    "entityName": "crfdf_jobsketchs",
                                    "recordId": "@first(body('Existing_Sketch'))?['crfdf_jobsketchid']",
                                    "item/crfdf_jobno": "@trim(items('For_each_job')?['crfdf_jobnumber'])",
                                    "item/crfdf_name": "@trim(items('For_each_job')?['crfdf_jobnumber'])",
                                    "item/crfdf_fileurl": "@concat(join(take(split(parameters('Sp_Site'), '/'), 3), '/'), replace(replace(replace(outputs('Pick_Sketch')?['FileRef'], '%', '%25'), ' ', '%20'), '#', '%23'))",
                                    "item/crfdf_filename": "@outputs('Pick_Sketch')?['FileLeafRef']",
                                    "item/crfdf_fileversion": "@if(and(equals(actions('Download_Thumbnail')?['status'], 'Succeeded'), not(empty(body('Download_Thumbnail')?['$content']))), concat('v4|', outputs('Pick_Sketch')?['UniqueId'], '|', outputs('Pick_Sketch')?['Modified']), concat(concat('v4|', outputs('Pick_Sketch')?['UniqueId'], '|', outputs('Pick_Sketch')?['Modified']), '|no-thumbnail'))",
                                    "item/crfdf_thumbnail": "@if(and(equals(actions('Download_Thumbnail')?['status'], 'Succeeded'), not(empty(body('Download_Thumbnail')?['$content']))), concat('data:', coalesce(body('Download_Thumbnail')?['$content-type'], 'image/jpeg'), ';base64,', body('Download_Thumbnail')?['$content']), concat('error: ', take(concat('Thumb_Info=', coalesce(actions('Thumb_Info')?['status'], ''), ' ', string(coalesce(actions('Thumb_Info')?['outputs']?['body'], actions('Thumb_Info')?['error'], '')), ' || ', 'Download_Thumbnail=', coalesce(actions('Download_Thumbnail')?['status'], ''), ' ', string(coalesce(actions('Download_Thumbnail')?['outputs']?['body'], actions('Download_Thumbnail')?['error'], ''))), 3000)))"
                                  },
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                    "connectionName": "shared_commondataserviceforapps",
                                    "operationId": "UpdateOnlyRecord"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Had_Sketch": {
                        "type": "If",
                        "runAfter": {},
                        "expression": {
                          "not": {
                            "equals": [
                              "@empty(first(body('Existing_Sketch')))",
                              true
                            ]
                          }
                        },
                        "actions": {
                          "Remove_Sketch": {
                            "type": "OpenApiConnection",
                            "runAfter": {},
                            "inputs": {
                              "parameters": {
                                "entityName": "crfdf_jobsketchs",
                                "recordId": "@first(body('Existing_Sketch'))?['crfdf_jobsketchid']"
                              },
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "DeleteRecord"
                              }
                            }
                          }
                        },
                        "else": {
                          "actions": {}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
