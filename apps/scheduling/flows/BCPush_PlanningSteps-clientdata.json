{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_bcpush"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "comment": "BCPush_PlanningSteps - drains crfdf_bcpushqueue rows of kind schedule/completion into our own BC web service LumineoProjectPlanning (page 58400 over ICG.IPP.ProjectPlanning, bc/lumineo-planning-ext). One row per (job, BC catalogue step): crfdf_planningstep is the step NAME, matched on Step_Description; PATCHed if the job has the row, else CREATED. Schedule writes only Sched_Start/Sched_End (+Assigned_To when set) - the page converts to Central and never touches Started. Completion writes Complete (+Started when completing). See BCPush_PlanningSteps.md.",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Bc_ODataBase": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com/v2.0/fe0182fa-d183-46ab-8493-9e8ea9c3d0b8/UAT/ODataV4"
        },
        "Bc_Company": {
          "type": "String",
          "defaultValue": "Luminous Neon"
        },
        "Bc_Service": {
          "type": "String",
          "defaultValue": "LumineoProjectPlanning"
        },
        "Bc_Tenant": {
          "type": "String",
          "defaultValue": "fe0182fa-d183-46ab-8493-9e8ea9c3d0b8"
        },
        "Bc_Audience": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com"
        },
        "Bc_ClientId": {
          "type": "String",
          "defaultValue": "<< Postman app registration client id >>"
        },
        "Bc_ClientSecret": {
          "type": "String",
          "defaultValue": "<< store in Key Vault / secure env var - do NOT commit >>"
        }
      },
      "triggers": {
        "When_a_push_row_is_added": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "crfdf_bcpushqueue",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "crfdf_status"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "shared_commondataserviceforapps"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Only_pending_step_rows": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@triggerOutputs()?['body/crfdf_status']",
                  "pending"
                ]
              },
              {
                "or": [
                  {
                    "equals": [
                      "@triggerOutputs()?['body/crfdf_kind']",
                      "schedule"
                    ]
                  },
                  {
                    "equals": [
                      "@triggerOutputs()?['body/crfdf_kind']",
                      "completion"
                    ]
                  }
                ]
              },
              {
                "not": {
                  "equals": [
                    "@empty(triggerOutputs()?['body/crfdf_planningstep'])",
                    true
                  ]
                }
              }
            ]
          },
          "runAfter": {},
          "actions": {
            "Try": {
              "type": "Scope",
              "runAfter": {},
              "actions": {
                "Get_Job_Rows": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('Bc_ODataBase')}/Company('@{encodeUriComponent(parameters('Bc_Company'))}')/@{parameters('Bc_Service')}?$filter=@{encodeUriComponent(concat('Project_No eq ''', replace(triggerOutputs()?['body/crfdf_jobno'], '''', ''''''), ''''))}",
                    "headers": {
                      "Accept": "application/json"
                    },
                    "authentication": {
                      "type": "ActiveDirectoryOAuth",
                      "authority": "https://login.microsoftonline.com",
                      "tenant": "@parameters('Bc_Tenant')",
                      "audience": "@parameters('Bc_Audience')",
                      "clientId": "@parameters('Bc_ClientId')",
                      "secret": "@parameters('Bc_ClientSecret')"
                    }
                  }
                },
                "Match_Step": {
                  "type": "Query",
                  "runAfter": {
                    "Get_Job_Rows": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Get_Job_Rows')?['value']",
                    "where": "@equals(item()?['Step_Description'], triggerOutputs()?['body/crfdf_planningstep'])"
                  }
                },
                "Push_Body": {
                  "type": "Compose",
                  "runAfter": {
                    "Match_Step": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@if(equals(triggerOutputs()?['body/crfdf_kind'], 'schedule'), if(empty(triggerOutputs()?['body/crfdf_assignedto']), addProperty(addProperty(json('{}'), 'Sched_Start', triggerOutputs()?['body/crfdf_startdatetime']), 'Sched_End', triggerOutputs()?['body/crfdf_enddatetime']), addProperty(addProperty(addProperty(json('{}'), 'Sched_Start', triggerOutputs()?['body/crfdf_startdatetime']), 'Sched_End', triggerOutputs()?['body/crfdf_enddatetime']), 'Assigned_To', triggerOutputs()?['body/crfdf_assignedto'])), if(equals(triggerOutputs()?['body/crfdf_complete'], true), json('{\"Complete\":true,\"Started\":true}'), json('{\"Complete\":false}')))"
                },
                "Row_Exists": {
                  "type": "If",
                  "runAfter": {
                    "Push_Body": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "greater": [
                      "@length(body('Match_Step'))",
                      0
                    ]
                  },
                  "actions": {
                    "Patch_Row": {
                      "type": "Http",
                      "runAfter": {},
                      "inputs": {
                        "method": "PATCH",
                        "uri": "@{parameters('Bc_ODataBase')}/Company('@{encodeUriComponent(parameters('Bc_Company'))}')/@{parameters('Bc_Service')}(Project_No='@{encodeUriComponent(replace(triggerOutputs()?['body/crfdf_jobno'], '''', ''''''))}',Code=@{first(body('Match_Step'))?['Code']})",
                        "headers": {
                          "Content-Type": "application/json",
                          "If-Match": "*"
                        },
                        "body": "@outputs('Push_Body')",
                        "authentication": {
                          "type": "ActiveDirectoryOAuth",
                          "authority": "https://login.microsoftonline.com",
                          "tenant": "@parameters('Bc_Tenant')",
                          "audience": "@parameters('Bc_Audience')",
                          "clientId": "@parameters('Bc_ClientId')",
                          "secret": "@parameters('Bc_ClientSecret')"
                        }
                      }
                    },
                    "Mark_Updated": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "entityName": "crfdf_bcpushqueues",
                          "recordId": "@triggerOutputs()?['body/crfdf_bcpushqueueid']",
                          "item/crfdf_status": "synced",
                          "item/crfdf_statusmessage": "@concat('updated ', triggerOutputs()?['body/crfdf_planningstep'])"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "operationId": "UpdateRecord",
                          "connectionName": "shared_commondataserviceforapps"
                        }
                      },
                      "runAfter": {
                        "Patch_Row": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Needs_Create": {
                        "type": "If",
                        "runAfter": {},
                        "expression": {
                          "or": [
                            {
                              "equals": [
                                "@triggerOutputs()?['body/crfdf_kind']",
                                "schedule"
                              ]
                            },
                            {
                              "equals": [
                                "@triggerOutputs()?['body/crfdf_complete']",
                                true
                              ]
                            }
                          ]
                        },
                        "actions": {
                          "Create_Row": {
                            "type": "Http",
                            "runAfter": {},
                            "inputs": {
                              "method": "POST",
                              "uri": "@{parameters('Bc_ODataBase')}/Company('@{encodeUriComponent(parameters('Bc_Company'))}')/@{parameters('Bc_Service')}",
                              "headers": {
                                "Content-Type": "application/json"
                              },
                              "body": "@addProperty(addProperty(outputs('Push_Body'), 'Project_No', triggerOutputs()?['body/crfdf_jobno']), 'Step_Description', triggerOutputs()?['body/crfdf_planningstep'])",
                              "authentication": {
                                "type": "ActiveDirectoryOAuth",
                                "authority": "https://login.microsoftonline.com",
                                "tenant": "@parameters('Bc_Tenant')",
                                "audience": "@parameters('Bc_Audience')",
                                "clientId": "@parameters('Bc_ClientId')",
                                "secret": "@parameters('Bc_ClientSecret')"
                              }
                            }
                          },
                          "Mark_Created": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "parameters": {
                                "entityName": "crfdf_bcpushqueues",
                                "recordId": "@triggerOutputs()?['body/crfdf_bcpushqueueid']",
                                "item/crfdf_status": "synced",
                                "item/crfdf_statusmessage": "@concat('created ', triggerOutputs()?['body/crfdf_planningstep'])"
                              },
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                "operationId": "UpdateRecord",
                                "connectionName": "shared_commondataserviceforapps"
                              }
                            },
                            "runAfter": {
                              "Create_Row": [
                                "Succeeded"
                              ]
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "Mark_Nothing_To_Reopen": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "entityName": "crfdf_bcpushqueues",
                                  "recordId": "@triggerOutputs()?['body/crfdf_bcpushqueueid']",
                                  "item/crfdf_status": "synced",
                                  "item/crfdf_statusmessage": "@concat('no BC row for ', triggerOutputs()?['body/crfdf_planningstep'], ' - nothing to re-open')"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "operationId": "UpdateRecord",
                                  "connectionName": "shared_commondataserviceforapps"
                                }
                              },
                              "runAfter": {}
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "Catch": {
              "type": "Scope",
              "runAfter": {
                "Try": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "actions": {
                "Mark_Failed": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "crfdf_bcpushqueues",
                      "recordId": "@triggerOutputs()?['body/crfdf_bcpushqueueid']",
                      "item/crfdf_status": "failed",
                      "item/crfdf_statusmessage": "@concat('BC push failed: ', coalesce(body('Patch_Row')?['error']?['message'], body('Create_Row')?['error']?['message'], body('Get_Job_Rows')?['error']?['message'], 'see run history'))"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "runAfter": {}
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
