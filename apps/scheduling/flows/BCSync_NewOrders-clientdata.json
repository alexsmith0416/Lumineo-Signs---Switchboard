                                    "item/crfdf_jobnumber": "@items('For_each_new_job')",
                                    "item/crfdf_description": "@first(body('Get_BC_Job')?['value'])?['description']",
                                    "item/crfdf_billtocustomerno": "@first(body('Get_BC_Job')?['value'])?['billToCustomerNo']",
                                    "item/crfdf_customername": "@coalesce(first(body('Get_Customer')?['value'])?['crfdf_customername'], items('For_each_new_job'))",
                                    "item/crfdf_status": "@first(body('Get_BC_Job')?['value'])?['status']",
                                    "item/crfdf_promiseddate": "@if(or(empty(coalesce(first(body('Get_BC_Job')?['value'])?['endingDate'], '')), startsWith(coalesce(first(body('Get_BC_Job')?['value'])?['endingDate'], ''), '0001')), null, first(body('Get_BC_Job')?['value'])?['endingDate'])",
                                    "item/crfdf_releasedate": "@if(or(empty(coalesce(first(body('Get_Release_Date')?['value'])?['icgSgpOrderReleasedDate'], '')), startsWith(coalesce(first(body('Get_Release_Date')?['value'])?['icgSgpOrderReleasedDate'], ''), '0001')), null, first(body('Get_Release_Date')?['value'])?['icgSgpOrderReleasedDate'])",
                                    "item/crfdf_appjobname": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToName']), if(empty(first(body('Get_Sales_Order')?['value'])?['customerName']), coalesce(first(body('Get_Customer')?['value'])?['crfdf_customername'], items('For_each_new_job')), first(body('Get_Sales_Order')?['value'])?['customerName']), first(body('Get_Sales_Order')?['value'])?['shipToName'])",
                                    "item/crfdf_shiptoaddress": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToAddressLine1']), first(body('Get_Customer')?['value'])?['crfdf_addressline1'], first(body('Get_Sales_Order')?['value'])?['shipToAddressLine1'])",
                                    "item/crfdf_shiptocity": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToCity']), first(body('Get_Customer')?['value'])?['crfdf_city'], first(body('Get_Sales_Order')?['value'])?['shipToCity'])",
                                    "item/crfdf_shiptostate": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToState']), first(body('Get_Customer')?['value'])?['crfdf_state'], first(body('Get_Sales_Order')?['value'])?['shipToState'])",
                                    "item/crfdf_shiptozip": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToPostCode']), first(body('Get_Customer')?['value'])?['crfdf_postalcode'], first(body('Get_Sales_Order')?['value'])?['shipToPostCode'])",
                                    "item/crfdf_saleslinefound": "@greater(length(coalesce(body('Get_Sales_Lines')?['value'], json('[]'))), 0)",
                                    "item/crfdf_salesdocumentno": "@first(body('Get_Sales_Lines')?['value'])?['documentNo']",
                                    "item/crfdf_saleslinedescription": "@first(body('Get_Sales_Lines')?['value'])?['description']",
                                    "item/crfdf_saleslinesselltono": "@first(body('Get_Sales_Lines')?['value'])?['sellToCustomerNo']",
                                    "item/crfdf_remainingbalance": "@first(body('Get_Sales_Lines')?['value'])?['outstandingAmountLCY']",
                                    "item/crfdf_salesorderamount": "@first(body('Get_Sales_Order')?['value'])?['totalAmountExcludingTax']",
                                    "item/crfdf_salespersoncode": "@if(empty(first(body('Get_Sales_Order')?['value'])?['salesperson']), first(body('Get_Sales_Lines')?['value'])?['salespersonCode'], first(body('Get_Sales_Order')?['value'])?['salesperson'])"
                                  },
