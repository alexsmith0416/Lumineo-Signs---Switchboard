      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_4a52d"
        },
        "runtimeSource": "embedded"
      },
      "shared_dynamicssmbsaas": {
        "api": {
          "name": "shared_dynamicssmbsaas"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_shareddynamicssmbsaas_69260"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "comment": "BCSync_NewOrders - GENERATED by _gen_neworders_flow.py; edit that, not this. Adds a job to the Jobs list (crfdf_jobtrack, status New_Order_Status) once its New Order This Week step is Started in BC Project Planning, and fills its crfdf_bcjobs row + planning lines from BC right away. See BCSync_NewOrders.md.",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Bc_ODataBase": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com/v2.0/fe0182fa-d183-46ab-8493-9e8ea9c3d0b8/UAT/ODataV4"
        },
        "Bc_Company": {
          "type": "String",
          "defaultValue": "Luminous Neon"
        },
        "Bc_Service": {
          "type": "String",
          "defaultValue": "LumineoProjectPlanning"
        },
        "Bc_Tenant": {
          "type": "String",
          "defaultValue": "fe0182fa-d183-46ab-8493-9e8ea9c3d0b8"
        },
        "Bc_Audience": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com"
        },
        "Bc_ClientId": {
          "type": "String",
          "defaultValue": "<< Postman app registration client id >>"
        },
        "Bc_ClientSecret": {
          "type": "String",
          "defaultValue": "<< store in Key Vault / secure env var - do NOT commit >>"
        },
        "Bc_Environment": {
          "type": "String",
          "defaultValue": "UAT"
        },
        "Bc_CompanyId": {
          "type": "String",
          "defaultValue": "4738bfb5-a06d-ec11-bf27-000d3a132a9e"
        },
        "Bc_AnalyticsDataset": {
          "type": "String",
          "defaultValue": "microsoft/analytics/v1.0"
        },
        "Bc_Sign365Dataset": {
          "type": "String",
          "defaultValue": "infotechConsultingGroup/sign365/v1.0"
        },
        "New_Order_Step": {
          "type": "String",
          "defaultValue": "New Order This Week"
        },
        "New_Order_Status": {
          "type": "String",
          "defaultValue": "New Order this week"
        },
        "Lookback_Days": {
          "type": "Int",
          "defaultValue": 3
        }
      },
      "triggers": {
        "Every_15_minutes": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Minute",
            "interval": 15
          }
        }
      },
      "actions": {
        "Get_Started_Steps": {
          "type": "Http",
          "runAfter": {},
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('Bc_ODataBase')}/Company('@{encodeUriComponent(parameters('Bc_Company'))}')/@{parameters('Bc_Service')}?$filter=@{encodeUriComponent(concat('Started eq true and SystemModifiedAt gt ', formatDateTime(addDays(utcNow(), mul(-1, int(parameters('Lookback_Days')))), 'yyyy-MM-ddTHH:mm:ssZ')))}&$select=Project_No,Step_Description",
            "headers": {
              "Accept": "application/json"
            },
            "authentication": {
              "type": "ActiveDirectoryOAuth",
              "authority": "https://login.microsoftonline.com",
              "tenant": "@parameters('Bc_Tenant')",
              "audience": "@parameters('Bc_Audience')",
              "clientId": "@parameters('Bc_ClientId')",
              "secret": "@parameters('Bc_ClientSecret')"
            }
          }
        },
        "New_Order_Steps": {
          "type": "Query",
          "runAfter": {
            "Get_Started_Steps": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Get_Started_Steps')?['value']",
            "where": "@equals(toLower(trim(coalesce(item()?['Step_Description'], ''))), toLower(trim(parameters('New_Order_Step'))))"
          }
        },
        "New_Order_Job_Numbers": {
          "type": "Select",
          "runAfter": {
            "New_Order_Steps": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('New_Order_Steps')",
            "select": "@item()?['Project_No']"
          }
        },
        "Any_New_Orders": {
          "type": "If",
          "runAfter": {
            "New_Order_Job_Numbers": [
              "Succeeded"
            ]
          },
          "expression": {
            "greater": [
              "@length(body('New_Order_Job_Numbers'))",
              0
            ]
          },
          "actions": {
            "List_Tracked_Jobs": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "parameters": {
                  "entityName": "crfdf_jobtracks",
                  "$select": "crfdf_jobno"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords"
                }
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 5000
                }
              }
            },
            "Tracked_Job_Numbers": {
              "type": "Select",
              "runAfter": {
                "List_Tracked_Jobs": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('List_Tracked_Jobs')?['value']",
                "select": "@trim(coalesce(item()?['crfdf_jobno'], ''))"
              }
            },
            "Untracked_Jobs": {
              "type": "Query",
              "runAfter": {
                "Tracked_Job_Numbers": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@union(body('New_Order_Job_Numbers'), body('New_Order_Job_Numbers'))",
                "where": "@not(contains(body('Tracked_Job_Numbers'), trim(item())))"
              }
            },
            "For_each_new_job": {
              "type": "Foreach",
              "foreach": "@body('Untracked_Jobs')",
              "runAfter": {
                "Untracked_Jobs": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Get_BC_Job": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "parameters": {
                      "bcenvironment": "@parameters('Bc_Environment')",
                      "company": "@parameters('Bc_CompanyId')",
                      "dataset": "@parameters('Bc_AnalyticsDataset')",
                      "table": "jobs",
                      "$filter": "no eq '@{replace(items('For_each_new_job'), '''', '''''')}'"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_dynamicssmbsaas",
                      "connectionName": "shared_dynamicssmbsaas",
                      "operationId": "GetItemsV3"
                    }
                  }
                },
                "Job_Is_Open": {
                  "type": "If",
                  "runAfter": {
                    "Get_BC_Job": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@length(body('Get_BC_Job')?['value'])",
                          0
                        ]
                      },
                      {
                        "equals": [
                          "@first(body('Get_BC_Job')?['value'])?['status']",
                          "Open"
                        ]
                      },
                      {
                        "not": {
                          "equals": [
                            "@first(body('Get_BC_Job')?['value'])?['complete']",
                            true
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "Add_To_Jobs_List": {
                      "type": "OpenApiConnection",
                      "runAfter": {},
                      "inputs": {
                        "parameters": {
                          "entityName": "crfdf_jobtracks",
                          "item/crfdf_jobno": "@items('For_each_new_job')",
                          "item/crfdf_name": "@items('For_each_new_job')",
                          "item/crfdf_statusoverride": "@parameters('New_Order_Status')"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord"
                        }
                      }
                    },
                    "Fill_In_From_BC": {
                      "type": "Scope",
                      "runAfter": {
                        "Add_To_Jobs_List": [
                          "Succeeded"
                        ]
                      },
                      "actions": {
                        "Get_Release_Date": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "parameters": {
                              "bcenvironment": "@parameters('Bc_Environment')",
                              "company": "@parameters('Bc_CompanyId')",
                              "dataset": "@parameters('Bc_Sign365Dataset')",
                              "table": "jobs",
                              "$filter": "no eq '@{replace(items('For_each_new_job'), '''', '''''')}'"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_dynamicssmbsaas",
                              "connectionName": "shared_dynamicssmbsaas",
                              "operationId": "GetItemsV3"
                            }
                          }
                        },
                        "Get_Customer": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "parameters": {
                              "entityName": "crfdf_bccustomers",
                              "$select": "crfdf_customername,crfdf_addressline1,crfdf_city,crfdf_state,crfdf_postalcode",
                              "$filter": "crfdf_customerno eq '@{replace(coalesce(first(body('Get_BC_Job')?['value'])?['billToCustomerNo'], ''), '''', '''''')}'",
                              "$top": 1
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "ListRecords"
                            }
                          }
                        },
                        "Get_Sales_Lines": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "parameters": {
                              "bcenvironment": "@parameters('Bc_Environment')",
                              "company": "@parameters('Bc_CompanyId')",
                              "dataset": "@parameters('Bc_AnalyticsDataset')",
                              "table": "salesLines",
                              "$filter": "projectNo eq '@{replace(items('For_each_new_job'), '''', '''''')}' and documentType eq 'Order'"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_dynamicssmbsaas",
                              "connectionName": "shared_dynamicssmbsaas",
                              "operationId": "GetItemsV3"
                            }
                          }
                        },
                        "Get_Sales_Order": {
                          "type": "OpenApiConnection",
                          "runAfter": {
                            "Get_Sales_Lines": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "parameters": {
                              "bcenvironment": "@parameters('Bc_Environment')",
                              "company": "@parameters('Bc_CompanyId')",
                              "dataset": "v2.0",
                              "table": "salesOrders",
                              "$filter": "number eq '@{replace(coalesce(first(body('Get_Sales_Lines')?['value'])?['documentNo'], ''), '''', '''''')}'",
                              "$top": 1
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_dynamicssmbsaas",
                              "connectionName": "shared_dynamicssmbsaas",
                              "operationId": "GetItemsV3"
                            }
                          }
                        },
                        "Find_BC_Job_Row": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "parameters": {
                              "entityName": "crfdf_bcjobs",
                              "$select": "crfdf_bcjobid",
                              "$filter": "crfdf_jobnumber eq '@{replace(items('For_each_new_job'), '''', '''''')}'",
                              "$top": 1
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "ListRecords"
                            }
                          }
                        },
                        "BC_Job_Row_Exists": {
                          "type": "If",
                          "runAfter": {
                            "Get_Release_Date": [
                              "Succeeded",
                              "Failed",
                              "Skipped"
                            ],
                            "Get_Customer": [
                              "Succeeded",
                              "Failed",
                              "Skipped"
                            ],
                            "Get_Sales_Order": [
                              "Succeeded",
                              "Failed",
                              "Skipped"
                            ],
                            "Find_BC_Job_Row": [
                              "Succeeded"
                            ]
                          },
                          "expression": {
                            "greater": [
                              "@length(body('Find_BC_Job_Row')?['value'])",
                              0
                            ]
                          },
                          "actions": {
                            "Update_BC_Job": {
                              "type": "OpenApiConnection",
                              "runAfter": {},
                              "inputs": {
                                "parameters": {
                                  "entityName": "crfdf_bcjobs",
                                  "recordId": "@first(body('Find_BC_Job_Row')?['value'])?['crfdf_bcjobid']",
                                  "item/crfdf_jobnumber": "@items('For_each_new_job')",
                                  "item/crfdf_description": "@first(body('Get_BC_Job')?['value'])?['description']",
                                  "item/crfdf_billtocustomerno": "@first(body('Get_BC_Job')?['value'])?['billToCustomerNo']",
                                  "item/crfdf_customername": "@coalesce(first(body('Get_Customer')?['value'])?['crfdf_customername'], items('For_each_new_job'))",
                                  "item/crfdf_status": "@first(body('Get_BC_Job')?['value'])?['status']",
                                  "item/crfdf_promiseddate": "@if(or(empty(coalesce(first(body('Get_BC_Job')?['value'])?['endingDate'], '')), startsWith(coalesce(first(body('Get_BC_Job')?['value'])?['endingDate'], ''), '0001')), null, first(body('Get_BC_Job')?['value'])?['endingDate'])",
                                  "item/crfdf_releasedate": "@if(or(empty(coalesce(first(body('Get_Release_Date')?['value'])?['icgSgpOrderReleasedDate'], '')), startsWith(coalesce(first(body('Get_Release_Date')?['value'])?['icgSgpOrderReleasedDate'], ''), '0001')), null, first(body('Get_Release_Date')?['value'])?['icgSgpOrderReleasedDate'])",
                                  "item/crfdf_appjobname": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToName']), if(empty(first(body('Get_Sales_Order')?['value'])?['customerName']), coalesce(first(body('Get_Customer')?['value'])?['crfdf_customername'], items('For_each_new_job')), first(body('Get_Sales_Order')?['value'])?['customerName']), first(body('Get_Sales_Order')?['value'])?['shipToName'])",
                                  "item/crfdf_shiptoaddress": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToAddressLine1']), first(body('Get_Customer')?['value'])?['crfdf_addressline1'], first(body('Get_Sales_Order')?['value'])?['shipToAddressLine1'])",
                                  "item/crfdf_shiptocity": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToCity']), first(body('Get_Customer')?['value'])?['crfdf_city'], first(body('Get_Sales_Order')?['value'])?['shipToCity'])",
                                  "item/crfdf_shiptostate": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToState']), first(body('Get_Customer')?['value'])?['crfdf_state'], first(body('Get_Sales_Order')?['value'])?['shipToState'])",
                                  "item/crfdf_shiptozip": "@if(empty(first(body('Get_Sales_Order')?['value'])?['shipToPostCode']), first(body('Get_Customer')?['value'])?['crfdf_postalcode'], first(body('Get_Sales_Order')?['value'])?['shipToPostCode'])",
                                  "item/crfdf_saleslinefound": "@greater(length(coalesce(body('Get_Sales_Lines')?['value'], json('[]'))), 0)",
                                  "item/crfdf_salesdocumentno": "@first(body('Get_Sales_Lines')?['value'])?['documentNo']",
                                  "item/crfdf_saleslinedescription": "@first(body('Get_Sales_Lines')?['value'])?['description']",
                                  "item/crfdf_saleslinesselltono": "@first(body('Get_Sales_Lines')?['value'])?['sellToCustomerNo']",
                                  "item/crfdf_remainingbalance": "@first(body('Get_Sales_Lines')?['value'])?['outstandingAmountLCY']",
                                  "item/crfdf_salesorderamount": "@first(body('Get_Sales_Order')?['value'])?['totalAmountExcludingTax']",
                                  "item/crfdf_salespersoncode": "@if(empty(first(body('Get_Sales_Order')?['value'])?['salesperson']), first(body('Get_Sales_Lines')?['value'])?['salespersonCode'], first(body('Get_Sales_Order')?['value'])?['salesperson'])"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "UpdateOnlyRecord"
                                }
                              }
                            }
                          },
