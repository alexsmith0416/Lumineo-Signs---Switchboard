                        },
                        "Get_Planning_Lines": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "parameters": {
                              "bcenvironment": "@parameters('Bc_Environment')",
                              "company": "@parameters('Bc_CompanyId')",
                              "dataset": "@parameters('Bc_AnalyticsDataset')",
                              "table": "jobPlanningLines",
                              "$filter": "jobNo eq '@{replace(items('For_each_new_job'), '''', '''''')}'"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_dynamicssmbsaas",
                              "connectionName": "shared_dynamicssmbsaas",
                              "operationId": "GetItemsV3"
                            }
                          }
                        },
                        "Keep_Resource_Lines": {
                          "type": "Query",
                          "runAfter": {
                            "Get_Planning_Lines": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "from": "@body('Get_Planning_Lines')?['value']",
                            "where": "@or(equals(item()?['lineType'], 'Billable'), equals(item()?['jobType'], 'Resource'))"
                          }
                        },
                        "For_each_line": {
                          "type": "Foreach",
                          "foreach": "@body('Keep_Resource_Lines')",
                          "runAfter": {
                            "Keep_Resource_Lines": [
                              "Succeeded"
                            ]
                          },
                          "actions": {
                            "Find_Line": {
                              "type": "OpenApiConnection",
                              "runAfter": {},
                              "inputs": {
                                "parameters": {
                                  "entityName": "crfdf_bcplanninglines",
                                  "$select": "crfdf_bcplanninglineid",
                                  "$top": 1,
                                  "$filter": "crfdf_jobno eq '@{replace(items('For_each_new_job'), '''', '''''')}' and crfdf_jobtaskno eq '@{replace(coalesce(items('For_each_line')?['jobTaskNo'], ''), '''', '''''')}' and crfdf_lineno eq @{items('For_each_line')?['lineNo']}"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "ListRecords"
                                }
                              }
                            },
                            "Line_Exists": {
                              "type": "If",
                              "runAfter": {
                                "Find_Line": [
                                  "Succeeded"
                                ]
                              },
                              "expression": {
                                "greater": [
