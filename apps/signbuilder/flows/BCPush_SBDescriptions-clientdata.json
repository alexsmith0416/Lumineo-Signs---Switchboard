{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_4a52d"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "comment": "BCPush_SBDescriptions - GENERATED by apps/signbuilder/flows/build-bc-flows.mjs; edit that, not this. On a crfdf_sbdescpush row going pending: PATCH the project's Production / Field Description through the Sign Builder extension's jobDescriptions API.",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Bc_ApiBase": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com/v2.0/fe0182fa-d183-46ab-8493-9e8ea9c3d0b8/UAT/api"
        },
        "Bc_CompanyId": {
          "type": "String",
          "defaultValue": "4738bfb5-a06d-ec11-bf27-000d3a132a9e"
        },
        "Bc_Tenant": {
          "type": "String",
          "defaultValue": "fe0182fa-d183-46ab-8493-9e8ea9c3d0b8"
        },
        "Bc_Audience": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com"
        },
        "Bc_ClientId": {
          "type": "String",
          "defaultValue": "<< Postman app registration client id >>"
        },
        "Bc_ClientSecret": {
          "type": "String",
          "defaultValue": "<< store in Key Vault / secure env var - do NOT commit >>"
        }
      },
      "triggers": {
        "When_a_push_is_queued": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "crfdf_sbdescpush",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "crfdf_status"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 5
            }
          }
        }
      },
      "actions": {
        "Only_Pending": {
          "type": "If",
          "runAfter": {},
          "expression": {
            "equals": [
              "@toLower(trim(coalesce(triggerOutputs()?['body/crfdf_status'], '')))",
              "pending"
            ]
          },
          "actions": {
            "Write": {
              "type": "Scope",
              "runAfter": {},
              "actions": {
                "Get_Project": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('Bc_ApiBase')}/lumineo/signbuilder/v1.0/companies(@{parameters('Bc_CompanyId')})/jobDescriptions?$filter=@{encodeUriComponent(concat('number eq ''', trim(coalesce(triggerOutputs()?['body/crfdf_jobno'], '')), ''''))}&$select=id,number",
                    "headers": {
                      "Accept": "application/json"
                    },
                    "authentication": {
                      "type": "ActiveDirectoryOAuth",
                      "authority": "https://login.microsoftonline.com",
                      "tenant": "@parameters('Bc_Tenant')",
                      "audience": "@parameters('Bc_Audience')",
                      "clientId": "@parameters('Bc_ClientId')",
                      "secret": "@parameters('Bc_ClientSecret')"
                    }
                  }
                },
                "Body_Production": {
                  "type": "Compose",
                  "runAfter": {
                    "Get_Project": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@if(equals(triggerOutputs()?['body/crfdf_sendproduction'], true), setProperty(json('{}'), 'productionDescription', coalesce(triggerOutputs()?['body/crfdf_productiondesc'], '')), json('{}'))"
                },
                "Body_Both": {
                  "type": "Compose",
                  "runAfter": {
                    "Body_Production": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@if(equals(triggerOutputs()?['body/crfdf_sendfield'], true), setProperty(outputs('Body_Production'), 'fieldDescription', coalesce(triggerOutputs()?['body/crfdf_fielddesc'], '')), outputs('Body_Production'))"
                },
                "Project_Found": {
                  "type": "If",
                  "runAfter": {
                    "Body_Both": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "greater": [
                      "@length(coalesce(body('Get_Project')?['value'], json('[]')))",
                      0
                    ]
                  },
                  "actions": {
                    "Write_Descriptions": {
                      "type": "Http",
                      "runAfter": {},
                      "inputs": {
                        "method": "PATCH",
                        "uri": "@{parameters('Bc_ApiBase')}/lumineo/signbuilder/v1.0/companies(@{parameters('Bc_CompanyId')})/jobDescriptions(@{first(body('Get_Project')?['value'])?['id']})",
                        "headers": {
                          "Content-Type": "application/json",
                          "Accept": "application/json",
                          "If-Match": "*"
                        },
                        "body": "@outputs('Body_Both')",
                        "authentication": {
                          "type": "ActiveDirectoryOAuth",
                          "authority": "https://login.microsoftonline.com",
                          "tenant": "@parameters('Bc_Tenant')",
                          "audience": "@parameters('Bc_Audience')",
                          "clientId": "@parameters('Bc_ClientId')",
                          "secret": "@parameters('Bc_ClientSecret')"
                        }
                      }
                    },
                    "Mark_Synced": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "Write_Descriptions": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "parameters": {
                          "entityName": "crfdf_sbdescpushs",
                          "recordId": "@triggerOutputs()?['body/crfdf_sbdescpushid']",
                          "item/crfdf_status": "synced",
                          "item/crfdf_statusmessage": "@concat('Written to project ', trim(coalesce(triggerOutputs()?['body/crfdf_jobno'], '')), ' in BC.')"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateOnlyRecord"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Mark_Not_Found": {
                        "type": "OpenApiConnection",
                        "runAfter": {},
                        "inputs": {
                          "parameters": {
                            "entityName": "crfdf_sbdescpushs",
                            "recordId": "@triggerOutputs()?['body/crfdf_sbdescpushid']",
                            "item/crfdf_status": "failed",
                            "item/crfdf_statusmessage": "@concat('Project ', trim(coalesce(triggerOutputs()?['body/crfdf_jobno'], '')), ' was not found in BC.')"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "UpdateOnlyRecord"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "Error_Text": {
              "type": "Compose",
              "runAfter": {
                "Write": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "inputs": "@coalesce(body('Write_Descriptions')?['error']?['message'], body('Get_Project')?['error']?['message'], 'Could not write to BC - see the BCPush_SBDescriptions run history.')"
            },
            "Mark_Failed": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Error_Text": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "parameters": {
                  "entityName": "crfdf_sbdescpushs",
                  "recordId": "@triggerOutputs()?['body/crfdf_sbdescpushid']",
                  "item/crfdf_status": "failed",
                  "item/crfdf_statusmessage": "@if(greater(length(outputs('Error_Text')), 300), substring(outputs('Error_Text'), 0, 300), outputs('Error_Text'))"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
