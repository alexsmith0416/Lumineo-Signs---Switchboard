{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_4a52d"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "comment": "BCSync_SBJobs - GENERATED by apps/signbuilder/flows/build-bc-flows.mjs; edit that, not this. On a crfdf_syncrequest of kind sbjobs: BC projects in every status but Completed (Sign Builder extension API) into crfdf_sbjob.",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Bc_ApiBase": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com/v2.0/fe0182fa-d183-46ab-8493-9e8ea9c3d0b8/UAT/api"
        },
        "Bc_CompanyId": {
          "type": "String",
          "defaultValue": "4738bfb5-a06d-ec11-bf27-000d3a132a9e"
        },
        "Bc_Tenant": {
          "type": "String",
          "defaultValue": "fe0182fa-d183-46ab-8493-9e8ea9c3d0b8"
        },
        "Bc_Audience": {
          "type": "String",
          "defaultValue": "https://api.businesscentral.dynamics.com"
        },
        "Bc_ClientId": {
          "type": "String",
          "defaultValue": "<< Postman app registration client id >>"
        },
        "Bc_ClientSecret": {
          "type": "String",
          "defaultValue": "<< store in Key Vault / secure env var - do NOT commit >>"
        }
      },
      "triggers": {
        "When_a_check_is_requested": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "crfdf_syncrequest",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "crfdf_kind eq 'sbjobs'"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Mark_Running": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "parameters": {
              "entityName": "crfdf_syncrequests",
              "recordId": "@triggerOutputs()?['body/crfdf_syncrequestid']",
              "item/crfdf_status": "Running",
              "item/crfdf_result": ""
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateOnlyRecord"
            }
          }
        },
        "Check_BC": {
          "type": "Scope",
          "runAfter": {
            "Mark_Running": [
              "Succeeded"
            ]
          },
          "actions": {
            "Get_Projects": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "GET",
                "uri": "@{parameters('Bc_ApiBase')}/lumineo/signbuilder/v1.0/companies(@{parameters('Bc_CompanyId')})/projects?$filter=@{encodeUriComponent('status ne ''Completed''')}&$select=number,description,description2,billToCustomerNo,billToName,status,creationDate,personResponsible,lastModified",
                "headers": {
                  "Accept": "application/json"
                },
                "authentication": {
                  "type": "ActiveDirectoryOAuth",
                  "authority": "https://login.microsoftonline.com",
                  "tenant": "@parameters('Bc_Tenant')",
                  "audience": "@parameters('Bc_Audience')",
                  "clientId": "@parameters('Bc_ClientId')",
                  "secret": "@parameters('Bc_ClientSecret')"
                }
              }
            },
            "List_Existing": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "parameters": {
                  "entityName": "crfdf_sbjobs",
                  "$select": "crfdf_sbjobid,crfdf_jobno,crfdf_bcmodified"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords"
                }
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 100000
                }
              }
            },
            "Check_Single_Page": {
              "type": "If",
              "runAfter": {
                "Get_Projects": [
                  "Succeeded"
                ]
              },
              "expression": {
                "not": {
                  "equals": [
                    "@empty(coalesce(body('Get_Projects')?['@odata.nextLink'], ''))",
                    true
                  ]
                }
              },
              "actions": {
                "Stop_Paged": {
                  "type": "Terminate",
                  "runAfter": {},
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "Paged",
                      "message": "BC returned more than one page - add paging to BCSync_SBJobs."
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Projects": {
              "type": "Query",
              "runAfter": {
                "Check_Single_Page": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Get_Projects')?['value']",
                "where": "@not(empty(trim(coalesce(item()?['number'], ''))))"
              }
            },
            "Existing_Stamps": {
              "type": "Select",
              "runAfter": {
                "List_Existing": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('List_Existing')?['value']",
                "select": "@concat(trim(coalesce(item()?['crfdf_jobno'], '')), '~', coalesce(item()?['crfdf_bcmodified'], ''))"
              }
            },
            "Existing_Stamp_Text": {
              "type": "Compose",
              "runAfter": {
                "Existing_Stamps": [
                  "Succeeded"
                ]
              },
              "inputs": "@concat('^', join(body('Existing_Stamps'), '^'), '^')"
            },
            "Changed_Projects": {
              "type": "Query",
              "runAfter": {
                "Projects": [
                  "Succeeded"
                ],
                "Existing_Stamp_Text": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Projects')",
                "where": "@not(contains(outputs('Existing_Stamp_Text'), concat('^', concat(trim(coalesce(item()?['number'], '')), '~', coalesce(item()?['lastModified'], '')), '^')))"
              }
            },
            "For_each_changed_project": {
              "type": "Foreach",
              "foreach": "@body('Changed_Projects')",
              "runAfter": {
                "Changed_Projects": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 10
                }
              },
              "actions": {
                "Existing_Row": {
                  "type": "Query",
                  "runAfter": {},
                  "inputs": {
                    "from": "@body('List_Existing')?['value']",
                    "where": "@equals(trim(coalesce(item()?['crfdf_jobno'], '')), trim(items('For_each_changed_project')?['number']))"
                  }
                },
                "Row_Exists": {
                  "type": "If",
                  "runAfter": {
                    "Existing_Row": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "greater": [
                      "@length(body('Existing_Row'))",
                      0
                    ]
                  },
                  "actions": {
                    "Update_Project": {
                      "type": "OpenApiConnection",
                      "runAfter": {},
                      "inputs": {
                        "parameters": {
                          "entityName": "crfdf_sbjobs",
                          "recordId": "@first(body('Existing_Row'))?['crfdf_sbjobid']",
                          "item/crfdf_name": "@trim(items('For_each_changed_project')?['number'])",
                          "item/crfdf_jobno": "@trim(items('For_each_changed_project')?['number'])",
                          "item/crfdf_description": "@trim(concat(coalesce(items('For_each_changed_project')?['description'], ''), ' ', coalesce(items('For_each_changed_project')?['description2'], '')))",
                          "item/crfdf_customerno": "@coalesce(items('For_each_changed_project')?['billToCustomerNo'], '')",
                          "item/crfdf_customername": "@coalesce(items('For_each_changed_project')?['billToName'], '')",
                          "item/crfdf_status": "@coalesce(items('For_each_changed_project')?['status'], '')",
                          "item/crfdf_creationdate": "@coalesce(items('For_each_changed_project')?['creationDate'], '')",
                          "item/crfdf_personresponsible": "@coalesce(items('For_each_changed_project')?['personResponsible'], '')",
                          "item/crfdf_bcmodified": "@coalesce(items('For_each_changed_project')?['lastModified'], '')"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateOnlyRecord"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Create_Project": {
                        "type": "OpenApiConnection",
                        "runAfter": {},
                        "inputs": {
                          "parameters": {
                            "entityName": "crfdf_sbjobs",
                            "item/crfdf_name": "@trim(items('For_each_changed_project')?['number'])",
                            "item/crfdf_jobno": "@trim(items('For_each_changed_project')?['number'])",
                            "item/crfdf_description": "@trim(concat(coalesce(items('For_each_changed_project')?['description'], ''), ' ', coalesce(items('For_each_changed_project')?['description2'], '')))",
                            "item/crfdf_customerno": "@coalesce(items('For_each_changed_project')?['billToCustomerNo'], '')",
                            "item/crfdf_customername": "@coalesce(items('For_each_changed_project')?['billToName'], '')",
                            "item/crfdf_status": "@coalesce(items('For_each_changed_project')?['status'], '')",
                            "item/crfdf_creationdate": "@coalesce(items('For_each_changed_project')?['creationDate'], '')",
                            "item/crfdf_personresponsible": "@coalesce(items('For_each_changed_project')?['personResponsible'], '')",
                            "item/crfdf_bcmodified": "@coalesce(items('For_each_changed_project')?['lastModified'], '')"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "CreateRecord"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "Current_Numbers": {
              "type": "Select",
              "runAfter": {
                "Projects": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Projects')",
                "select": "@trim(coalesce(item()?['number'], ''))"
              }
            },
            "Current_Number_Text": {
              "type": "Compose",
              "runAfter": {
                "Current_Numbers": [
                  "Succeeded"
                ]
              },
              "inputs": "@concat('^', join(body('Current_Numbers'), '^'), '^')"
            },
            "Stale_Rows": {
              "type": "Query",
              "runAfter": {
                "Current_Number_Text": [
                  "Succeeded"
                ],
                "List_Existing": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('List_Existing')?['value']",
                "where": "@not(contains(outputs('Current_Number_Text'), concat('^', trim(coalesce(item()?['crfdf_jobno'], '')), '^')))"
              }
            },
            "Any_Projects": {
              "type": "If",
              "runAfter": {
                "Stale_Rows": [
                  "Succeeded"
                ],
                "For_each_changed_project": [
                  "Succeeded"
                ]
              },
              "expression": {
                "greater": [
                  "@length(body('Projects'))",
                  0
                ]
              },
              "actions": {
                "For_each_stale_row": {
                  "type": "Foreach",
                  "foreach": "@body('Stale_Rows')",
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 10
                    }
                  },
                  "actions": {
                    "Delete_Project": {
                      "type": "OpenApiConnection",
                      "runAfter": {},
                      "inputs": {
                        "parameters": {
                          "entityName": "crfdf_sbjobs",
                          "recordId": "@items('For_each_stale_row')?['crfdf_sbjobid']"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "DeleteRecord"
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          }
        },
        "Mark_Done": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Check_BC": [
              "Succeeded"
            ]
          },
          "inputs": {
            "parameters": {
              "entityName": "crfdf_syncrequests",
              "recordId": "@triggerOutputs()?['body/crfdf_syncrequestid']",
              "item/crfdf_status": "Done",
              "item/crfdf_result": "@if(equals(length(coalesce(body('Changed_Projects'), json('[]'))), 0), 'Projects up to date', concat(string(length(coalesce(body('Changed_Projects'), json('[]')))), if(equals(length(coalesce(body('Changed_Projects'), json('[]'))), 1), ' project updated', ' projects updated')))"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateOnlyRecord"
            }
          }
        },
        "Mark_Failed": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Check_BC": [
              "Failed",
              "TimedOut"
            ]
          },
          "inputs": {
            "parameters": {
              "entityName": "crfdf_syncrequests",
              "recordId": "@triggerOutputs()?['body/crfdf_syncrequestid']",
              "item/crfdf_status": "Failed",
              "item/crfdf_result": "@'Could not read BC - see the BCSync_SBJobs run history.'"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateOnlyRecord"
            }
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
