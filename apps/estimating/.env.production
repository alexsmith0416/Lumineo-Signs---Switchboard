# Production cross-link: the deployed Sign Builder Pro URL.
# Used by Estimating to build the "Open original in Sign Builder Pro" link.
# Baked in at `vite build` (production mode). A `window.LUMINEO_SIGN_BUILDER_URL`
# at runtime, or a Vercel env var of the same name, overrides this.
VITE_SIGN_BUILDER_URL=https://lumineo-signbuilderpro.vercel.app/
