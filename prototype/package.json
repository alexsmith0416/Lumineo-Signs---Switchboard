{
  "name": "lumineo-switchboard-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clickable splash-screen prototype for the Lumineo Switchboard master app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && STANDALONE=1 vite build",
    "build:all": "npm run build && npm run build:standalone",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@types/react-grid-layout": "^1.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
