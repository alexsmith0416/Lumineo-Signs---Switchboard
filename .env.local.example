# Business Central API credentials
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to source control

VITE_BC_TENANT_ID=your-tenant-guid-here
VITE_BC_ENVIRONMENT=PRODUCTION
VITE_BC_COMPANY_ID=your-company-guid-here
VITE_BC_CLIENT_ID=your-azure-app-client-id
VITE_BC_CLIENT_SECRET=your-azure-app-client-secret
