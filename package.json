{
  "name": "lumineo-switchboard",
  "private": true,
  "version": "0.1.0",
  "description": "Lumineo Signs Switchboard monorepo — master Power Apps shell + sub-apps.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "extract:estimating": "python scripts/extract-workbook.py",
    "build:estimating": "npm run build --workspace apps/estimating",
    "dev:estimating": "npm run dev --workspace apps/estimating -- --port 4802 --strictPort",
    "test:estimating": "npm test --workspace apps/estimating",
    "build:sign-builder": "npm run build --workspace apps/sign-builder",
    "dev:sign-builder": "npm run dev --workspace apps/sign-builder -- --port 4801 --strictPort",
    "test:sign-builder": "npm test --workspace apps/sign-builder",
    "build:wind-load": "npm run build --workspace apps/wind-load",
    "dev:wind-load": "npm run dev --workspace apps/wind-load -- --port 4803 --strictPort",
    "test:wind-load": "npm test --workspace apps/wind-load",
    "dev": "concurrently -k -n estimating,sign-builder,wind-load -c blue,magenta,green \"npm:dev:estimating\" \"npm:dev:sign-builder\" \"npm:dev:wind-load\"",
    "build": "npm run build:estimating && npm run build:sign-builder && npm run build:wind-load",
    "test": "npm run test:estimating && npm run test:sign-builder && npm run test:wind-load"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
