{
  "name": "lumineo-switchboard",
  "private": true,
  "version": "0.1.0",
  "description": "Lumineo Signs Switchboard monorepo — master Power Apps shell + sub-apps.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "extract:estimating": "python scripts/extract-workbook.py",
    "build:estimating": "npm run build --workspace apps/estimating",
    "dev:estimating": "npm run dev --workspace apps/estimating",
    "test:estimating": "npm test --workspace apps/estimating",
    "build:sign-builder": "npm run build --workspace apps/sign-builder",
    "dev:sign-builder": "npm run dev --workspace apps/sign-builder",
    "test:sign-builder": "npm test --workspace apps/sign-builder",
    "build": "npm run build:estimating && npm run build:sign-builder",
    "test": "npm run test:estimating && npm run test:sign-builder"
  },
  "engines": {
    "node": ">=20"
  }
}
